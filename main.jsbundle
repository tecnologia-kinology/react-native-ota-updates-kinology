luz_piscando_azul:'Luz azul piscando: procurando'},en:{luz_piscando_azul:'Blinking blue light: searching'},es:{luz_piscando_azul:'Luz azul intermitente: b\xfasqueda'}},{pt:{canhoto_destro:'O paciente \xe9 destro ou canhoto?'},en:{canhoto_destro:'Is the patient right-handed or left-handed?'},es:{canhoto_destro:'\xbfEl paciente es diestro o zurdo?'}},{pt:{sem_informacao_dominante:'Sem essa informa\xe7\xe3o n\xe3o \xe9 poss\xedvel prosseguir com a avalia\xe7\xe3o de preens\xe3o manual.'},en:{sem_informacao_dominante:'Without this information, it is not possible to proceed with the handgrip assessment.'},es:{sem_informacao_dominante:'Sin esta informaci\xf3n, no es posible proceder con la evaluaci\xf3n del agarre.'}},{pt:{canhoto:'Canhoto'},en:{canhoto:'Left-handed'},es:{canhoto:'Zurdo'}},{pt:{destro:'Destro'},en:{destro:'Right-handed'},es:{destro:'Diestro'}},{pt:{posicao:'Posi\xe7\xe3o'},en:{posicao:'Position'},es:{posicao:'Posici\xf3n'}},{pt:{voce_pode_enviar:'Voc\xea pode enviar para seu paciente responder sozinho ou realizar o question\xe1rio junto ao paciente.'},en:{voce_pode_enviar:'You can send it to your patient to answer alone or carry out the questionnaire with the patient.'},es:{voce_pode_enviar:'Puedes envi\xe1rselo a tu paciente para que responda solo o realizar el cuestionario con el paciente.'}},{pt:{carregando_protocolos:'Carregando protocolos'},en:{carregando_protocolos:'Loading protocols'},es:{carregando_protocolos:'Cargando protocolos'}},{pt:{adicionar_da_camera:'Adicionar\nda c\xe2mera'},en:{adicionar_da_camera:'Add\nfrom camera'},es:{adicionar_da_camera:'Agregar\nda c\xe1mara'}},{pt:{execucao_recuperada:'Execu\xe7\xe3o recuperada com sucesso.'},en:{execucao_recuperada:'Execution successfully recovered.'},es:{execucao_recuperada:'Ejecuci\xf3n recuperada con \xe9xito.'}},{pt:{execucao_recuperada_erro:'Erro ao recuperar execu\xe7\xe3o, tente novamente.'},en:{execucao_recuperada_erro:'Error recovering execution, please try again.'},es:{execucao_recuperada_erro:'Error al recuperar la ejecuci\xf3n, intente nuevamente.'}},{pt:{exercicio_recuperado:"Exerc\xedcio recuperado com sucesso."},en:{exercicio_recuperado:"Exercise successfully recovered."},es:{exercicio_recuperado:"Ejercicio recuperado con \xe9xito."}},{pt:{exercicio_recuperado_erro:"Erro ao recuperar exerc\xedcio, tente novamente."},en:{exercicio_recuperado_erro:"Error recovering exercise, please try again."},es:{exercicio_recuperado_erro:"Error al recuperar el ejercicio, intente nuevamente."}},{pt:{qualidade_de_vida_para_questionario:'Qualidade de vida'},en:{qualidade_de_vida_para_questionario:'Quality of life'},es:{qualidade_de_vida_para_questionario:'Calidad de vida'}},{pt:{avalaidor_request_sucesss:'Avaliador cadastrado com sucesso.'},en:{avalaidor_request_sucesss:'Evaluator successfully registered.'},es:{avalaidor_request_sucesss:'Evaluador registrado correctamente.'}},{pt:{execucao_excluida:'A execu\xe7\xe3o exclu\xedda'},en:{execucao_excluida:'Execution deleted'},es:{execucao_excluida:'Ejecuci\xf3n eliminada'}},{pt:{msg_compartilhar_pdf:'Ol\xe1! Para acessar os resultados da sua avalia\xe7\xe3o de for\xe7a, acesse o Relat\xf3rio Kinology no link abaixo.'},en:{msg_compartilhar_pdf:'Hello! To access the results of your strength assessment, access the Kinology Report at the link below.'},es:{msg_compartilhar_pdf:'\xa1Hola! Para acceder a los resultados de su evaluaci\xf3n de fuerza, acceda al Informe Kinology en el siguiente enlace.'}},{pt:{confirmar_limpar_pontos_dor:'Tem certeza que deseja limpar os pontos de dor?'},en:{confirmar_limpar_pontos_dor:'Are you sure you want to clear the pain points?'},es:{confirmar_limpar_pontos_dor:'Est\xe1s seguro de que quieres limpiar los puntos d\xe9biles?'}},{pt:{execucao_error_excluir:'Erro ao excluir execu\xe7\xe3o'},en:{execucao_error_excluir:'Error deleting execution'},es:{execucao_error_excluir:'Error al eliminar la ejecuci\xf3n'}},{pt:{confirmar_sair_da_pagina:'Tem certeza que deseja sair desta p\xe1gina?'},en:{confirmar_sair_da_pagina:'Are you sure you want to leave this page?'},es:{confirmar_sair_da_pagina:'Est\xe1s seguro de que quieres abandonar esta p\xe1gina?'}},{pt:{execucao_error_migrar:'Erro ao migrar execu\xe7\xe3o'},en:{execucao_error_migrar:'Error when migrating execution'},es:{execucao_error_migrar:'Error al migrar la ejecuci\xf3n'}},{pt:{nao_sera_possivel_recuperar_pontos_dor:'N\xe3o ser\xe1 poss\xedvel recuperar os pontos de dor selecionados.'},en:{nao_sera_possivel_recuperar_pontos_dor:'You will not be able to recover the selected pain points.'},es:{nao_sera_possivel_recuperar_pontos_dor:'No ser\xe1 posible recuperar los puntos d\xe9biles seleccionados.'}},{pt:{confirmar_excluir:'Tem certeza que deseja excluir as execu\xe7\xf5es abaixo?'},en:{confirmar_excluir:'Are you sure you want to delete the executions below?'},es:{confirmar_excluir:'\xbfEst\xe1 seguro de que desea eliminar las ejecuciones siguientes?'}},{pt:{infos_inseridas_nao_salvas:'As informa\xe7\xf5es que foram inseridas n\xe3o ser\xe3o salvas.'},en:{infos_inseridas_nao_salvas:'The information that was entered will not be saved.'},es:{infos_inseridas_nao_salvas:'La informaci\xf3n ingresada no se guardar\xe1.'}},{pt:{migrar_ou_excluir:'Migrar ou excluir execu\xe7\xf5es'},en:{migrar_ou_excluir:'Migrate or delete execution'},es:{migrar_ou_excluir:'Migrar o eliminar ejecuciones'}},{pt:{confirme_dados:'Confirme os dados:'},en:{confirme_dados:'For the patient:'},es:{confirme_dados:'Para el paciente:'}},{pt:{resultados_dor_difusa_pt2:'Avaliar gravidade'},en:{resultados_dor_difusa_pt2:'Assess severity'},es:{resultados_dor_difusa_pt2:'Evaluar la gravedad'}},{pt:{para_paciente:'Migrar para o(a) paciente:'},en:{para_paciente:'Migrate to patient:'},es:{para_paciente:'Migrar al paciente:'}},{pt:{gravidade:'Gravidade'},en:{gravidade:'Gravity'},es:{gravidade:'Gravedad'}},{pt:{deseja_migrar_excluir:'Deseja migrar ou excluir execu\xe7\xf5es?'},en:{deseja_migrar_excluir:'Do you want to migrate or delete runs?'},es:{deseja_migrar_excluir:'\xbfQuieres migrar o eliminar ejecuciones?'}},{pt:{resultados_dor_difusa_pt3:'para continuar o diagn\xf3stico.'},en:{resultados_dor_difusa_pt3:'to continue the diagnosis.'},es:{resultados_dor_difusa_pt3:'para continuar con el diagn\xf3stico.'}},{pt:{sera_redirecionado:'Voc\xea ser\xe1 redirecionado para o relat\xf3rio de'},en:{sera_redirecionado:'You will be redirected to the'},es:{sera_redirecionado:'Ser\xe1 redirigido al informe'}},{pt:{confira_resultados_dor_difusa:'Confira os resultados da pontua\xe7\xe3o de dor e da dor difusa.'},en:{confira_resultados_dor_difusa:'Check the results of the pain score and diffuse pain.'},es:{confira_resultados_dor_difusa:'Verifique la puntuaci\xf3n del dolor y los resultados del dolor difuso.'}},{pt:{sera_redirecionado2:'para migrar o paciente ou excluir execu\xe7\xf5es.'},en:{sera_redirecionado2:'to migrate the patient or delete runs.'},es:{sera_redirecionado2:'para migrar al paciente o eliminar ejecuciones.'}},{pt:{necessario_avaliar_gravidade:'Necess\xe1rio avaliar gravidade'},en:{necessario_avaliar_gravidade:'It is necessary to assess severity'},es:{necessario_avaliar_gravidade:'Necesidad de evaluar la gravedad'}},{pt:{historico_forca:'Hist\xf3rico de for\xe7a e valores de refer\xeancia'},en:{historico_forca:'Strength history and reference values'},es:{historico_forca:'Forzar historial y valores de referencia'}},{pt:{sem_indicativo_fibromialgia:'N\xe3o existe indicativos de Fibromialgia'},en:{sem_indicativo_fibromialgia:'There are no signs of Fibromyalgia'},es:{sem_indicativo_fibromialgia:'No hay signos de fibromialgia.'}},{pt:{desfazer_avaliador_excluido:'Avaliador exclu\xeddo com sucesso '},en:{desfazer_avaliador_excluido:'Evaluator deleted successfully'},es:{desfazer_avaliador_excluido:'Evaluador eliminado exitosamente'}},{pt:{salvar_edicao:'Salvar edi\xe7\xe3o'},en:{salvar_edicao:'Save edit'},es:{salvar_edicao:'Guardar edici\xf3n'}},{pt:{pontuacao_dor:'Pontua\xe7\xe3o total de dor'},en:{pontuacao_dor:'Total pain score'},es:{pontuacao_dor:'Puntuaci\xf3n total de dolor'}},{pt:{pontos:'Ponto(s)'},en:{pontos:'Point(s)'},es:{pontos:'Punto(s)'}},{pt:{pontos_legenda:'Ponto'},en:{pontos_legenda:'Point'},es:{pontos_legenda:'Punto'}},{pt:{pontos_fibromialgia:'Pontos de fibromialgia'},en:{pontos_fibromialgia:'Fibromyalgia Points'},es:{pontos_fibromialgia:'Puntos de fibromialgia'}},{pt:{pontuacao_de_dor_range:'Pontua\xe7\xe3o de dor (0 a 38 pontos)'},en:{pontuacao_de_dor_range:'Pain score (0 to 38 points)'},es:{pontuacao_de_dor_range:'Puntuaci\xf3n de dolor (0 a 38 puntos)'}},{pt:{interpretacao:'Interpreta\xe7\xe3o'},en:{interpretacao:'Interpretation'},es:{interpretacao:'Interpretaci\xf3n'}},{pt:{pontos_de_fibro:'Pontos de fibromialgia (0 a 19 pontos)'},en:{pontos_de_fibro:'Fibromyalgia Points (0 to 19 points)'},es:{pontos_de_fibro:'Puntos de fibromialgia (0 a 19 puntos)'}},{pt:{calculo_pontuacao_dor:'A Pontua\xe7\xe3o de Dor \xe9 calculada pelo relatado do paciente em uma mesma data que v\xe3o de 0 a 38 pontos de dor. '},en:{calculo_pontuacao_dor:'The Pain Score is calculated based on the patient`s reports on the same date, ranging from 0 to 38 pain points.'},es:{calculo_pontuacao_dor:'La puntuaci\xf3n de dolor se calcula en funci\xf3n del informe del paciente en la misma fecha y oscila entre 0 y 38 puntos de dolor.'}},{pt:{entenda_escala_gravidade:'Entenda a Escala de gravidade'},en:{entenda_escala_gravidade:'Understand the Gravity Scale'},es:{entenda_escala_gravidade:'Comprender la escala de gravedad'}},{pt:{para_indicar_risco_fibro:'Para podermos indicar se h\xe1 risco de fibromialgia ou n\xe3o, precisamos que responda '},en:{para_indicar_risco_fibro:'In order to indicate whether there is a risk of fibromyalgia or not, we need you to answer'},es:{para_indicar_risco_fibro:'Para que podamos indicar si existe riesgo de fibromialgia o no, necesitamos que respondas'}},{pt:{este_indice_avalia:'Este \xedndice avalia o n\xfamero de \xe1reas em que o paciente teve dor (de 0 a 19 pontos) em pontos caracter\xedsticos de fibromialgia e a gravidade do relato. O \xedndice leva em conta locais espec\xedficos identificados no gr\xe1fico, que s\xe3o considerados na pontua\xe7\xe3o total de dor do relat\xf3rio.'},en:{este_indice_avalia:'This index assesses the number of areas in which the patient had pain (from 0 to 19 points) in points characteristic of fibromyalgia and the severity of the report. The index takes into account specific locations identified on the graph, which are considered in the total pain score of the report.'},es:{este_indice_avalia:'Este \xedndice eval\xfaa el n\xfamero de \xe1reas en las que el paciente tuvo dolor (de 0 a 19 puntos) en puntos caracter\xedsticos de la fibromialgia y la gravedad del reporte. El \xedndice tiene en cuenta ubicaciones espec\xedficas identificadas en el gr\xe1fico, que se consideran en la puntuaci\xf3n total de dolor del informe.'}},{pt:{perguntas_sobre_gravidade:'4 perguntas sobre a gravidade'},en:{perguntas_sobre_gravidade:'4 questions about gravity'},es:{perguntas_sobre_gravidade:'4 preguntas sobre la gravedad'}},{pt:{seguintes_categorias:'das dores das seguintes categorias:'},en:{seguintes_categorias:'of the pains of the following categories:'},es:{seguintes_categorias:'dolor en las siguientes categor\xedas:'}},{pt:{perguntas_vao_ate_tres_pontos:'Essas perguntas v\xe3o de 0 a 3 pontos.'},en:{perguntas_vao_ate_tres_pontos:'These questions range from 0 to 3 points.'},es:{perguntas_vao_ate_tres_pontos:'Estas preguntas van de 0 a 3 puntos.'}},{pt:{fadiga_e_cansaco:'Fadiga e cansa\xe7o ao realizar atividades;'},en:{fadiga_e_cansaco:'Fatigue and tiredness when carrying out activities;'},es:{fadiga_e_cansaco:'Fatiga y cansancio al realizar actividades;'}},{pt:{sono_nao_reparador:'Sono n\xe3o reparador;'},en:{sono_nao_reparador:'Non-restorative sleep;'},es:{sono_nao_reparador:'Sue\xf1o no reparador;'}},{pt:{sintomas_cognitivos:'Sintomas cognitivos;'},en:{sintomas_cognitivos:'Cognitive symptoms;'},es:{sintomas_cognitivos:'S\xedntomas cognitivos;'}},{pt:{sintomas_somaticos:'Sintomas som\xe1ticos.'},en:{sintomas_somaticos:'Somatic symptoms.'},es:{sintomas_somaticos:'S\xedntomas som\xe1ticos.'}},{pt:{realmente_deseja_finalizar:'Tem certeza que deseja finalizar?'},en:{realmente_deseja_finalizar:'Are you sure you want to finish?'},es:{realmente_deseja_finalizar:'Est\xe1s seguro de que quieres terminar?'}},{pt:{recomendamos_que_avalie_gravidade:'Recomendamos que avalie a gravidade para identificarmos se existe ou n\xe3o indicativos de fibromialgia'},en:{recomendamos_que_avalie_gravidade:'We recommend that you assess the severity to identify whether or not there are signs of fibromyalgia.'},es:{recomendamos_que_avalie_gravidade:'Te recomendamos valorar la gravedad para identificar si hay o no signos de fibromialgia.'}},{pt:{indicativo_fibromialgia_:'Indicativo de Fibromialgia'},en:{indicativo_fibromialgia_:'Indicative of Fibromyalgia'},es:{indicativo_fibromialgia_:'Indicativo de fibromialgia'}},{pt:{fibromialgia_titulo:'Fibromialgia'},en:{fibromialgia_titulo:'Fibromyalgia'},es:{fibromialgia_titulo:'fibromialgia'}},{pt:{alivio:'Alivio'},en:{alivio:'Relief'},es:{alivio:'Alivio'}},{pt:{estabilidade:'Estabilidade'},en:{estabilidade:'Stability'},es:{estabilidade:'Estabilidad'}},{pt:{pontos_escala_wpi:'Pontos da Escala WPI'},en:{pontos_escala_wpi:'WPI Scale Points'},es:{pontos_escala_wpi:'Puntos de escala WPI'}},{pt:{intensificacao:'Intensifica\xe7\xe3o'},en:{intensificacao:'Intensification'},es:{intensificacao:'Intensificaci\xf3n'}},{pt:{pontuacao_fibromialgia_card:'Pontua\xe7\xe3o de fibromialgia'},en:{pontuacao_fibromialgia_card:'Fibromyalgia Score'},es:{pontuacao_fibromialgia_card:'Puntuaci\xf3n de fibromialgia'}},{pt:{pontuacao_sugestiva:'Pontua\xe7\xe3o sugestiva para fibromialgia. Consulte um especialista.'},en:{pontuacao_sugestiva:'Suggestive score for fibromyalgia. Consult a specialist.'},es:{pontuacao_sugestiva:'Puntuaci\xf3n sugerente para fibromialgia. Consulta a un especialista.'}},{pt:{CategoriaTable:'Categoria'},en:{CategoriaTable:'Category'},es:{CategoriaTable:'Categor\xeda'}},{pt:{fadiga_cansaco:'Fadiga e cansa\xe7o ao executar atividades'},en:{fadiga_cansaco:'Fatigue and tiredness when performing activities'},es:{fadiga_cansaco:'Fatiga y cansancio al realizar actividades.'}},{pt:{indice_de_dor_difusa:'O \xedndice de dor difusa for pelo menos 7 e a escala de gravidade for pelo menos 5;'},en:{indice_de_dor_difusa:'The diffuse pain index is at least 7 and the severity scale is at least 5;'},es:{indice_de_dor_difusa:'El \xedndice de dolor difuso es de al menos 7 y la escala de gravedad es de al menos 5;'}},{pt:{indice_de_dor_difusa2:'O \xedndice de dor difusa for entre 3-6 e a escala de gravidade for pelo menos 9.'},en:{indice_de_dor_difusa2:'The diffuse pain index is between 3-6 and the severity scale is at least 9.'},es:{indice_de_dor_difusa2:'El \xedndice de dolor difuso est\xe1 entre 3-6 y la escala de gravedad es al menos 9.'}},{pt:{nao_a_parametros_para_indicar:'N\xe3o h\xe1 par\xe2metros para indicar poss\xedvel fibromialgia de acordo com a Escala WSI.'},en:{nao_a_parametros_para_indicar:'There are no parameters to indicate possible fibromyalgia according to the WSI Scale.'},es:{nao_a_parametros_para_indicar:'No existen par\xe1metros que indiquen una posible fibromialgia seg\xfan la Escala WSI.'}},{pt:{evolucao_da_dor_e_comparacao:'A evolu\xe7\xe3o da dor \xe9 uma compara\xe7\xe3o referente \xe0 \xfaltima avalia\xe7\xe3o feita do mapa de dor.'},en:{evolucao_da_dor_e_comparacao:'Pain evolution is a comparison with the last assessment made of the pain map.'},es:{evolucao_da_dor_e_comparacao:'La evoluci\xf3n del dolor es una comparaci\xf3n con la \xfaltima valoraci\xf3n realizada del mapa del dolor.'}},{pt:{para_a_interpretacao_e_necessario:'Para a interpreta\xe7\xe3o, \xe9 necess\xe1rio somar os pontos para os dois crit\xe9rios de forma individual (pontos para o \xedndice de dor difusa e pontos para a escala de gravidade). Assim, o diagn\xf3stico de fibromialgia \xe9 confirmado quando uma das duas for verdadeira:'},en:{para_a_interpretacao_e_necessario:'For interpretation, it is necessary to add the points for the two criteria individually (points for the diffuse pain index and points for the severity scale). Thus, the diagnosis of fibromyalgia is confirmed when one of the two is true:'},es:{para_a_interpretacao_e_necessario:'Para la interpretaci\xf3n, es necesario sumar los puntos de los dos criterios individualmente (puntos para el \xedndice de dolor difuso y puntos para la escala de gravedad). As\xed, el diagn\xf3stico de fibromialgia se confirma cuando se cumple una de las dos condiciones:'}},{pt:{mapa_de_dor_indicativo_fibromialgia_pagina:'Mapa de dor e indicativo \nde Fibromialgia'},en:{mapa_de_dor_indicativo_fibromialgia_pagina:'Pain map and indication \nof Fibromyalgia'},es:{mapa_de_dor_indicativo_fibromialgia_pagina:'Mapa del dolor e indicaci\xf3n \nde la Fibromialgia'}},{pt:{cliente_reportou_total:'Seu cliente reportou um total de'},en:{cliente_reportou_total:'Your client reported a total of'},es:{cliente_reportou_total:'Su cliente report\xf3 un total de'}},{pt:{ponto_dor:'ponto(s)'},en:{ponto_dor:'point(s)'},es:{ponto_dor:'punto(s)'}},{pt:{dentre_eles:'dentre eles'},en:{dentre_eles:'among them'},es:{dentre_eles:'entre ellos'}},{pt:{selecionado_pontos_fibromialgia:'selecionado(s) s\xe3o pontos de fibromialgia.'},en:{selecionado_pontos_fibromialgia:'selected are fibromyalgia points.'},es:{selecionado_pontos_fibromialgia:'seleccionado(s) son puntos de fibromialgia.'}},{pt:{indicativos_fibromialgia:'Existindo poss\xedveis indicativos de Fibromialgia'},en:{indicativos_fibromialgia:'There are possible indicators of Fibromyalgia'},es:{indicativos_fibromialgia:'Existen posibles indicadores de Fibromialgia'}},{pt:{questionario_escala_gravidade:'\xc9 necess\xe1rio realizar o question\xe1rio de Escala de Gravidade para a conclus\xe3o da avalia\xe7\xe3o.'},en:{questionario_escala_gravidade:'It is necessary to take the Severity Scale questionnaire to complete the assessment.'},es:{questionario_escala_gravidade:'Es necesario realizar el cuestionario de la Escala de Gravedad para completar la evaluaci\xf3n.'}},{pt:{nao_existindo_indicativos_fibromialgia:'N\xe3o existindo indicativos de Fibromialgia'},en:{nao_existindo_indicativos_fibromialgia:'There are no indicators of Fibromyalgia'},es:{nao_existindo_indicativos_fibromialgia:'No existen indicadores de Fibromialgia'}},{pt:{continuar_encerrar_avaliacao:'neste cliente, voc\xea pode continuar e realizar o question\xe1rio de Escala de Gravidade ou encerrar a avalia\xe7\xe3o.'},en:{continuar_encerrar_avaliacao:'for this client, you can continue and take the Severity Scale questionnaire or close the assessment.'},es:{continuar_encerrar_avaliacao:'en este cliente, puede continuar y realizar el cuestionario de Escala de Gravedad o cerrar la evaluaci\xf3n.'}},{pt:{o_que_e_fibromialgia:'O que \xe9 Fibromialgia?'},en:{o_que_e_fibromialgia:'What is Fibromyalgia?'},es:{o_que_e_fibromialgia:'\xbfQu\xe9 es la fibromialgia?'}},{pt:{o_que_e_fibromialgia_descricao:'A fibromialgia \xe9 uma condi\xe7\xe3o de sa\xfade cr\xf4nica caracterizada por dores musculoesquel\xe9ticas generalizadas, acompanhadas de fadiga, dist\xfarbios do sono, problemas de mem\xf3ria e altera\xe7\xf5es de humor. \xc9 considerada uma s\xedndrome, pois engloba um conjunto de sintomas que variam de pessoa para pessoa.'},en:{o_que_e_fibromialgia_descricao:'Fibromyalgia is a chronic health condition characterized by widespread musculoskeletal pain, accompanied by fatigue, sleep disturbances, memory problems, and mood changes. It is considered a syndrome because it encompasses a set of symptoms that vary from person to person.'},es:{o_que_e_fibromialgia_descricao:'La fibromialgia es una condici\xf3n de salud cr\xf3nica caracterizada por dolores musculoesquel\xe9ticos generalizados, acompa\xf1ados de fatiga, trastornos del sue\xf1o, problemas de memoria y cambios de humor. Se considera un s\xedndrome porque abarca un conjunto de s\xedntomas que var\xedan de persona a persona.'}},{pt:{como_funciona_pontuacao_fibromialgia:'Como funciona a pontua\xe7\xe3o de Fibromialgia?'},en:{como_funciona_pontuacao_fibromialgia:'How does the Fibromyalgia scoring work?'},es:{como_funciona_pontuacao_fibromialgia:'\xbfC\xf3mo funciona la puntuaci\xf3n de la fibromialgia?'}},{pt:{pontos_fibromialgia_selecionados:'Dentre os pontos que foram selecionados no mapa de dor, dezenove (19) deles s\xe3o pontos de fibromialgia. S\xf3 \xe9 poss\xedvel confirmar se h\xe1 indicativos de fibromialgia ou n\xe3o ap\xf3s a avalia\xe7\xe3o da gravidade. Confira a tabela abaixo.'},en:{pontos_fibromialgia_selecionados:'Among the points selected on the pain map, nineteen (19) are fibromyalgia points. It is only possible to confirm whether there are indicators of fibromyalgia or not after assessing the severity. Check the table below.'},es:{puntos_fibromialgia_seleccionados:'De los puntos seleccionados en el mapa de dolor, diecinueve (19) son puntos de fibromialgia. Solo es posible confirmar si existen indicios de fibromialgia o no despu\xe9s de evaluar la gravedad. Consulte la tabla a continuaci\xf3n.'}},{pt:{quando_realizar_questionario:'Quando devo realizar o question\xe1rio?'},en:{quando_realizar_questionario:'When should I take the questionnaire?'},es:{quando_realizar_questionario:'\xbfCu\xe1ndo debo realizar el cuestionario?'}},{pt:{indicacao_questionario:'Indicamos a realiza\xe7\xe3o dos question\xe1rios caso a pontua\xe7\xe3o de fibromialgia seja maior ou igual a tr\xeas (3).'},en:{indicacao_questionario:'We recommend taking the questionnaire if the fibromyalgia score is greater than or equal to three (3).'},es:{indicacao_questionario:'Recomendamos realizar el cuestionario si la puntuaci\xf3n de fibromialgia es mayor o igual a tres (3).'}},{pt:{avaliar_gravidade_fibromialgia:'Se este \xe9 o caso do seu cliente, clique em \u201cAvaliar gravidade\u201d para concluir a avalia\xe7\xe3o de fibromialgia.'},en:{avaliar_gravidade_fibromialgia:'If this is the case for your client, click \u201cAssess severity\u201d to complete the fibromyalgia assessment.'},es:{avaliar_gravidade_fibromialgia:'Si este es el caso de su cliente, haga clic en \u201cEvaluar gravedad\u201d para completar la evaluaci\xf3n de fibromialgia.'}},{pt:{como_funciona_escala_gravidade:'Como funciona a Escala de gravidade?'},en:{como_funciona_escala_gravidade:'How does the Severity Scale work?'},es:{como_funciona_escala_gravidade:'\xbfC\xf3mo funciona la Escala de gravedad?'}},{pt:{indicar_risco_fibromialgia:'Para podermos indicar se h\xe1 risco de fibromialgia ou n\xe3o, precisamos que o seu cliente responda'},en:{indicar_risco_fibromialgia:'In order to indicate whether there is a risk of fibromyalgia or not, we need your client to answer'},es:{indicar_risco_fibromialgia:'Para poder indicar si existe riesgo de fibromialgia o no, necesitamos que su cliente responda'}},{pt:{quatro_perguntas:'4 perguntas'},en:{quatro_perguntas:'4 questions'},es:{quatro_perguntas:'4 preguntas'}},{pt:{gravidade_dores_categoria:'Sobre a gravidade das dores das seguintes categorias:'},en:{gravidade_dores_categoria:'About the severity of pain in the following categories:'},es:{gravidade_dores_categoria:'Sobre la gravedad del dolor en las siguientes categor\xedas:'}},{pt:{escala_gravidade_fibromialgia:'Essas perguntas v\xe3o de 0 a 3 pontos. E a soma da escala de gravidade + as pontua\xe7\xf5es de fibromialgia podem ou n\xe3o resultar em pontua\xe7\xe3o sugestiva de fibromialgia.'},en:{escala_gravidade_fibromialgia:'These questions range from 0 to 3 points. And the sum of the severity scale + the fibromyalgia scores may or may not result in a suggestive fibromyalgia score.'},es:{escala_gravidade_fibromialgia:'Estas preguntas van de 0 a 3 puntos. Y la suma de la escala de gravedad + las puntuaciones de fibromialgia pueden o no resultar en una puntuaci\xf3n sugestiva de fibromialgia.'}},{pt:{menor_que:'menor que'},en:{menor_que:'less than'},es:{menor_que:'menos que'}},{pt:{maior_ou_igual_a:'maior ou igual a'},en:{maior_ou_igual_a:'greater than or equal to'},es:{maior_ou_igual_a:'mayor o igual a'}},{pt:{evolucao_dor:'Evolu\xe7\xe3o da dor*'},en:{evolucao_dor:'Pain evolution*'},es:{evolucao_dor:'Evoluci\xf3n del dolor*'}},{pt:{escala_gravidade:'Escala de gravidade'},en:{escala_gravidade:'Severity scale'},es:{escala_gravidade:'Escala de gravedad'}},{pt:{pontuacao:'Pontua\xe7\xe3o'},en:{pontuacao:'Score'},es:{pontuacao:'Puntuaci\xf3n'}},{pt:{interpretacao_somar_pontos:'Para a interpreta\xe7\xe3o, \xe9 necess\xe1rio somar os pontos para os dois crit\xe9rios de forma individual (pontos de fibromialgia e pontos para a escala de gravidade).'},en:{interpretacao_somar_pontos:'For interpretation, it is necessary to sum the points for both criteria individually (fibromyalgia points and severity scale points).'},es:{interpretacao_somar_pontos:'Para la interpretaci\xf3n, es necesario sumar los puntos para ambos criterios de forma individual (puntos de fibromialgia y puntos para la escala de gravedad).'}},{pt:{indicativo_fibromialgia:'Indicativo de Fibromialgia'},en:{indicativo_fibromialgia:'Fibromyalgia Indicator'},es:{indicativo_fibromialgia:'Indicador de Fibromialgia'}},{pt:{pontos_fibromialgia_mais:'Pontos de fibromialgia +'},en:{pontos_fibromialgia_mais:'Fibromyalgia points +'},es:{pontos_fibromialgia_mais:'Puntos de fibromialgia +'}},{pt:{pontuacao_nao_sugestiva:'Pontua\xe7\xe3o N\xc3O sugestiva para fibromialgia.'},en:{pontuacao_nao_sugestiva:'Score NOT suggestive of fibromyalgia.'},es:{pontuacao_nao_sugestiva:'Puntuaci\xf3n NO sugestiva de fibromialgia.'}},{pt:{clique_em_avaliar_na_tabela:'Clique em "Avaliar" na tabela da Escala de gravidade.'},en:{clique_em_avaliar_na_tabela:'Click "Rate" in the Severity Scale table.'},es:{clique_em_avaliar_na_tabela:'Haga clic en \u201cCalificaci\xf3n\u201d en la tabla de escala de gravedad.'}},{pt:{pontos_na_escala_gravidade:'pontos da escala de gravidade ='},en:{pontos_na_escala_gravidade:'severity scale points ='},es:{pontos_na_escala_gravidade:'puntos de la escala de gravedad ='}},{pt:{editar_ou_excluir_dor:'Clique nas \xe1reas de dor ao lado para editar ou \n excluir alguma \xe1rea de dor.'},en:{editar_ou_excluir_dor:'Click on the areas of pain on the side to edit or\n delete any area of pain.'},es:{editar_ou_excluir_dor:'Haga clic en las \xe1reas de dolor al lado para editar o\n eliminar cualquier \xe1rea de dolor.'}},{pt:{clique_para_indicar:'Clique para indicar as'},en:{clique_para_indicar:'Click to indicate the'},es:{clique_para_indicar:'Haga clic para indicar las'}},{pt:{nivelTable:'N\xedvel'},en:{nivelTable:'Level'},es:{nivelTable:'Nivel'}},{pt:{areas_de_dor:'\xc1reas de dor'},en:{areas_de_dor:'Areas of pain'},es:{areas_de_dor:'\xc1reas de dolor'}},{pt:{do_cliente_na:'do cliente na'},en:{do_cliente_na:'of the client in the'},es:{do_cliente_na:'del cliente en la'}},{pt:{confirmar_excluir_area_de_dor:'Tem certeza que deseja excluir essa \xe1rea de dor?'},en:{confirmar_excluir_area_de_dor:'Are you sure you want to delete this pain area?'},es:{confirmar_excluir_area_de_dor:'\xbfEst\xe1 seguro de que desea eliminar esta \xe1rea de dolor?'}},{pt:{ver_resumo:'Ver resumo'},en:{ver_resumo:'View summary'},es:{ver_resumo:'Ver resumen'}},{pt:{mandibula_eva:'Mand\xedbula e Face lateral'},en:{mandibula_eva:'Mandible and lateral face'},es:{mandibula_eva:'Mand\xedbula y cara lateral'}},{pt:{ombro_eva:'Ombro e Peitoral'},en:{ombro_eva:'Shoulder and Chest'},es:{ombro_eva:'Hombro y pecho'}},{pt:{braco_eva:'Bra\xe7o e Cotovelo'},en:{braco_eva:'Arm and Elbow'},es:{braco_eva:'Brazo y codo'}},{pt:{antebraco_eva:'Antebra\xe7o, Punho e M\xe3o'},en:{antebraco_eva:'Forearm, Wrist and Hand'},es:{antebraco_eva:'Antebrazo, mu\xf1eca y mano'}},{pt:{torax_eva:'Torax, Abdome superior e Diafragma'},en:{torax_eva:'Chest, Upper Abdomen and Diaphragm'},es:{torax_eva:'Pecho, abdomen superior y diafragma'}},{pt:{abdome_eva:'Abd\xf4me superior e Pelve'},en:{abdome_eva:'Upper Abdomen and Pelvis'},es:{abdome_eva:'Abdomen superior y pelvis'}},{pt:{coxa_eva:'Coxa anterior e lateral externa'},en:{coxa_eva:'Anterior and lateral outer thigh'},es:{coxa_eva:'Muslo externo anterior y lateral'}},{pt:{joelho_eva:'Joelho'},en:{joelho_eva:'Knee'},es:{joelho_eva:'Rodilla'}},{pt:{perna_eva:'Perna'},en:{perna_eva:'Leg'},es:{perna_eva:'Pierna'}},{pt:{pe_eva:'P\xe9 e tornozelo'},en:{pe_eva:'Foot and ankle'},es:{pe_eva:'Pie y tobillo'}},{pt:{pescoco_eva:'Pesco\xe7o anterior e posterior'},en:{pescoco_eva:'Anterior and posterior neck'},es:{pescoco_eva:'Cuello anterior y posterior'}},{pt:{ombro_posterior_eva:'Ombro e trap\xe9zio'},en:{ombro_posterior_eva:'Shoulder and trapezius'},es:{ombro_posterior_eva:'Hombro y trapecio'}},{pt:{coluna_superior_eva:'Coluna superior e Cervical'},en:{coluna_superior_eva:'Upper and Cervical Spine'},es:{coluna_superior_eva:'Columna superior y cervical'}},{pt:{coluna_central_eva:'Central Spine and Thoracic Region'},en:{coluna_central_eva:'Central Spine and Thoracic Region'},es:{coluna_central_eva:'Columna central y regi\xf3n tor\xe1cica'}},{pt:{braco_posterior_eva:'Bra\xe7o e Cotovelo'},en:{braco_posterior_eva:'Arm and Elbow'},es:{braco_posterior_eva:'Brazo y codo'}},{pt:{punho_eva:'Antebra\xe7o, Punho e M\xe3o'},en:{punho_eva:'Forearm, Wrist and Hand'},es:{punho_eva:'Antebrazo, mu\xf1eca y mano'}},{pt:{lombar_eva:'Lombar e grande dorsal'},en:{lombar_eva:'Lumbar and latissimus dorsi'},es:{lombar_eva:'Lumbar y dorsal ancho'}},{pt:{quadril_eva:'Quadril e Gl\xfateo'},en:{quadril_eva:'Hip and Glutes'},es:{quadril_eva:'Cadera y gl\xfateos'}},{pt:{coxa_posterior_eva:'Coxa posterior e lateral interna'},en:{coxa_posterior_eva:'Posterior and inner lateral thigh'},es:{coxa_posterior_eva:'Cara interna posterior y lateral del muslo'}},{pt:{perna_posterior_eva:'Panturrilha e posterior do joelho'},en:{perna_posterior_eva:'Calf and back of the knee'},es:{perna_posterior_eva:'Pantorrilla y parte posterior de la rodilla'}},{pt:{tornozelo_eva:'Tornozelo e calcanhar'},en:{tornozelo_eva:'Ankle and heel'},es:{tornozelo_eva:'Tobillo y tal\xf3n'}},{pt:{desfazer_avaliador_excluido:'Avaliador exclu\xeddo com sucesso '},en:{desfazer_avaliador_excluido:'Evaluator deleted successfully'},es:{desfazer_avaliador_excluido:'Evaluador eliminado exitosamente'}},{pt:{salvar_edicao:'Salvar edi\xe7\xe3o'},en:{salvar_edicao:'Save edit'},es:{salvar_edicao:'Guardar edici\xf3n'}},{pt:{nao_realizou_anamnese:'Voc\xea ainda n\xe3o realizou a anamnese desse paciente.'},en:{nao_realizou_anamnese:"You have not yet performed this patient's anamnesis"},es:{nao_realizou_anamnese:'A\xfan no has realizado la anamnesis de este paciente'}},{pt:{sao_apresentadas_medicoes:'S\xe3o apresentadas as medi\xe7\xf5es atuais em comparativo com a medi\xe7\xe3o anterior.'},en:{sao_apresentadas_medicoes:'The current measurements are displayed in comparison to the previous measurement.'},es:{sao_apresentadas_medicoes:'Se muestran las mediciones actuales en comparaci\xf3n con la medici\xf3n anterior.'}},{pt:{mapa_de_dor_indicativo_fibromialgia:'Mapa de dor e indicativo de Fibromialgia'},en:{mapa_de_dor_indicativo_fibromialgia:'Pain map and indication of Fibromyalgia'},es:{mapa_de_dor_indicativo_fibromialgia:'Mapa del dolor e indicaci\xf3n de la Fibromialgia'}},{pt:{title_card_history_fibro:'Mapa de dor e Indicativo de Fibromialgia'},en:{title_card_history_fibro:'Pain Map and Fibromyalgia Indicator'},es:{title_card_history_fibro:'Mapa de dolor e indicaci\xf3n de Fibromialgia'}},{pt:{indice_avalia_o_numero:'A Pontua\xe7\xe3o de Dor \xe9 calculada pela somat\xf3ria dos pontos da Escala de Dor relatados pelo paciente uma mesma data. O Indicativo de Fibromialgia \xe9 calculado segundo a metodologia Widespread Pain Index (WPI) usado pela Sociedade Americana de Reumatologia. Este \xedndice avalia o n\xfamero de \xe1reas em que o paciente teve dor difusa nos \xfaltimos sete dias e a gravidade do relato. O \xedndice leva em conta locais espec\xedficos identificados no gr\xe1fico, que s\xe3o considerados na pontua\xe7\xe3o total de dor do relat\xf3rio. Para mais detalhes, consulte a \xe1rea de refer\xeancias cient\xedficas.'},en:{indice_avalia_o_numero:'The Pain Score is calculated by adding up the Pain Scale points reported by the patient on the same date. The Fibromyalgia Index is calculated according to the Widespread Pain Index (WPI) methodology used by the American Society of Rheumatology. This index assesses the number of areas in which the patient has had diffuse pain in the last seven days and the severity of the report. The index takes into account specific locations identified on the graph, which are considered in the total pain score of the report. For more details, see the scientific references area.'},es:{indice_avalia_o_numero:'La puntuaci\xf3n del dolor se calcula sumando los puntos de la escala de dolor informados por el paciente en la misma fecha. El Indicador de Fibromialgia se calcula seg\xfan la metodolog\xeda del \xcdndice de Dolor Generalizado (WPI) utilizada por la Sociedad Estadounidense de Reumatolog\xeda. Este \xedndice eval\xfaa la cantidad de \xe1reas en las que el paciente present\xf3 dolor difuso en los \xfaltimos siete d\xedas y la gravedad del reporte. El \xedndice tiene en cuenta ubicaciones espec\xedficas identificadas en el gr\xe1fico, que se consideran en la puntuaci\xf3n total de dolor del informe. Para m\xe1s detalles, consulte el \xe1rea de referencias cient\xedficas.'}},{pt:{data_realizacao:'Data de realiza\xe7\xe3o'},en:{data_realizacao:'Date of completion'},es:{data_realizacao:'Fecha de finalizaci\xf3n'}},{pt:{copy:'\xa9American Fibromyalgia Society. O WPI \xe9 uma marca da American Fibromyalgia Society. Estados Unidos.'},en:{copy:'\xa9American Fibromyalgia Society. WPI is a trademark of the American Fibromyalgia Society. United States.'},es:{copy:'\xa9Sociedad Americana de Fibromialgia. WPI es una marca de la Sociedad Estadounidense de Fibromialgia. Estados Unidos.'}},{pt:{pontos_de_dor:'Ponto(s) de dor'},en:{pontos_de_dor:'Pain point(s)'},es:{pontos_de_dor:'Punto(s) de dolor'}},{pt:{clique_indicar_pontos_dor:'Clique para indicar os pontos de dor'},en:{clique_indicar_pontos_dor:'Click to indicate pain points'},es:{clique_indicar_pontos_dor:'Haga clic para indicar los puntos d\xe9biles'}},{pt:{marque_nivel_dor:'Marque o n\xedvel de dor do seu paciente:'},en:{marque_nivel_dor:'Mark your patient`s pain level:'},es:{marque_nivel_dor:'Marque el nivel de dolor de su paciente:'}},{pt:{titulo_avaliacao_gravidade_eva:'Avalia\xe7\xe3o de gravidade'},en:{titulo_avaliacao_gravidade_eva:'Gravity assessment'},es:{titulo_avaliacao_gravidade_eva:'Evaluaci\xf3n de la gravedad'}},{pt:{mapa_de_dor_indicativo_title_page:'Mapa de dor e indicativo \n de Fibromialgia'},en:{mapa_de_dor_indicativo_title_page:'Pain map and indication \nof Fibromyalgia'},es:{mapa_de_dor_indicativo_title_page:'Mapa del dolor e indicaci\xf3n \nde la Fibromialgia'}},{pt:{reajuste:'Reajuste no seu plano'},en:{reajuste:'Adjustment to your plan'},es:{reajuste:'Ajuste a su plan'}},{pt:{garantir_qualidade:'Para garantir essa qualidade e acompanhar os ajustes econ\xf4micos do per\xedodo,'},en:{garantir_qualidade:'To ensure this quality and keep up with the economic adjustments of the period,'},es:{garantir_qualidade:'Para garantizar esta calidad y estar a la altura de los ajustes econ\xf3micos del per\xedodo,'}},{pt:{atualizacao_valores:'realizaremos uma atualiza\xe7\xe3o nos planos e valores a partir de Abril.'},en:{atualizacao_valores:'We will update plans and prices starting in April.'},es:{atualizacao_valores:'Actualizaremos planes y precios a partir de abril.'}},{pt:{mudancas_contrato:'Saiba sobre as mudan\xe7as acessando o seu contrato atualizado'},en:{mudancas_contrato:'Learn about the changes by accessing your updated contract'},es:{mudancas_contrato:'Inf\xf3rmate sobre los cambios accediendo a tu contrato actualizado'}},{pt:{confirme_contrato:'e confirme abaixo. Para mais informa\xe7\xf5es, confira sua caixa de entrada.'},en:{confirme_contrato:'and confirm below. For more information, check your inbox.'},es:{confirme_contrato:'y confirme a continuaci\xf3n. Para obtener m\xe1s informaci\xf3n, revise su bandeja de entrada.'}},{pt:{estou_ciente_reajuste:'Estou ciente sobre a atualiza\xe7\xe3o do plano e reajuste de valores.'},en:{estou_ciente_reajuste:'I am aware of the plan update and price adjustment.'},es:{estou_ciente_reajuste:'Estoy al tanto de la actualizaci\xf3n del plan y del ajuste de precios.'}},{pt:{termo_respondido_sucesso:'Termo respondido com sucesso.'},en:{termo_respondido_sucesso:'Term answered successfully.'},es:{termo_respondido_sucesso:'T\xe9rmino respondido exitosamente.'}},{pt:{termo_respondido_erro:'Erro ao responder o termo.'},en:{termo_respondido_erro:'Error responding to the term.'},es:{termo_respondido_erro:'Error al responder el t\xe9rmino.'}},{pt:{fatura_pendente:"Fatura Pendente"},en:{fatura_pendente:"Pending Invoice"},es:{fatura_pendente:"Factura Pendiente"}},{pt:{evite_negativacao:"Evite a negativa\xe7\xe3o no SERASA"},en:{evite_negativacao:"Avoid negative credit in SERASA"},es:{evite_negativacao:"Evita la negativaci\xf3n en SERASA"}},{pt:{cargo:"Cargo"},en:{cargo:"Role"},es:{cargo:"Cargo"}},{pt:{efetue_pagamento:"Efetue o pagamento"},en:{efetue_pagamento:"Make the payment"},es:{efetue_pagamento:"Realiza el pago"}},{pt:{inscricao:"Inscri\xe7\xe3o"},en:{inscricao:"Registration"},es:{inscricao:"Inscripci\xf3n"}},{pt:{pagamento_atraso:"Verificamos que existe pagamento de fatura em atraso."},en:{pagamento_atraso:"We have detected an overdue invoice payment."},es:{pagamento_atraso:"Hemos detectado un pago de factura vencido."}},{pt:{carregando_informacoes_paciente:"Carregando informa\xe7\xf5es do paciente"},en:{carregando_informacoes_paciente:"Loading patient information"},es:{carregando_informacoes_paciente:"Cargando informaci\xf3n del paciente"}},{pt:{efetue_pagamento_bloqueio:"Efetue o pagamento e evite o bloqueio do aplicativo."},en:{efetue_pagamento_bloqueio:"Make the payment and avoid the app being blocked."},es:{efetue_pagamento_bloqueio:"Realiza el pago y evita el bloqueo de la aplicaci\xf3n."}},{pt:{termo_consentimento_sucesso:"Termo de consentimento respondido com sucesso"},en:{termo_consentimento_sucesso:"Consent form successfully completed"},es:{termo_consentimento_sucesso:"Formulario de consentimiento respondido con \xe9xito"}},{pt:{negativacao_proxima:"Seu nome est\xe1 pr\xf3ximo de ser negativado devido a uma pend\xeancia de pagamento em sua assinatura."},en:{negativacao_proxima:"Your name is close to being negatively reported due to an outstanding payment on your subscription."},es:{negativacao_proxima:"Su nombre est\xe1 a punto de ser negativado debido a un pendiente de pago en su suscripci\xf3n."}},{pt:{erro_termo_consentimento:"Erro ao responder o termo de consentimento, tente novamente"},en:{erro_termo_consentimento:"Error completing the consent form, please try again"},es:{erro_termo_consentimento:"Error al responder el formulario de consentimiento, intente nuevamente"}},{pt:{voce_pode:"Voc\xea pode"},en:{voce_pode:"You can"},es:{voce_pode:"Puedes"}},{pt:{termo_consentimento_livre_esclarecido:"Termo de consentimento livre e esclarecido"},en:{termo_consentimento_livre_esclarecido:"Free and informed consent form"},es:{termo_consentimento_livre_esclarecido:"Formulario de consentimiento libre e informado"}},{pt:{efetuar_pagamento_entrar_contato:"efetuar o pagamento ou entrar em contato"},en:{efetuar_pagamento_entrar_contato:"make the payment or get in touch"},es:{efetuar_pagamento_entrar_contato:"realiza el pago o contacta"}},{pt:{termo_deve_ser_lido:"Termo deve ser lido pelo paciente, que pode ou n\xe3o autorizar os procedimentos"},en:{termo_deve_ser_lido:"The form must be read by the patient, who may or may not authorize the procedures"},es:{termo_deve_ser_lido:"El formulario debe ser le\xeddo por el paciente, quien puede o no autorizar los procedimientos"}},{pt:{encontrar_solucao:"para encontrarmos uma solu\xe7\xe3o para voc\xea."},en:{encontrar_solucao:"to find a solution for you."},es:{encontrar_solucao:"para encontrar una soluci\xf3n para ti."}},{pt:{projeto_avaliacao_osteomuscular:"Projeto de Avalia\xe7\xe3o Osteomuscular"},en:{projeto_avaliacao_osteomuscular:"Osteomuscular Assessment Project"},es:{projeto_avaliacao_osteomuscular:"Proyecto de Evaluaci\xf3n Osteomuscular"}},{pt:{debito_em_nome:"Verificamos que existe um d\xe9bito em seu nome."},en:{debito_em_nome:"We have detected a debt in your name."},es:{debito_em_nome:"Hemos detectado una deuda a su nombre."}},{pt:{objetivo_documento:"Este documento tem como objetivo esclarecer os participantes sobre sua participa\xe7\xe3o no Projeto de Avalia\xe7\xe3o Osteomuscular, envolvendo avalia\xe7\xf5es funcionais com uso  dinam\xf4metro isom\xe9trico, conforme estabelecido pelo pr\xf3prio programa. Caso concorde, assine ao final."},en:{objetivo_documento:"This document aims to inform participants about their participation in the Musculoskeletal Assessment Project, involving functional assessments using an isometric dynamometer, as established by the program itself. If you agree, please sign at the end."},es:{objetivo_documento:"Este documento tiene como objetivo aclarar a los participantes sobre su participaci\xf3n en el Proyecto de Evaluaci\xf3n Osteomuscular, que implica evaluaciones funcionales mediante dinam\xf3metro isom\xe9trico, seg\xfan lo establecido por el propio programa. Si est\xe1s de acuerdo firma al final."}},{pt:{entrar_contato_solucao:"ou entre em contato para encontrarmos uma solu\xe7\xe3o para voc\xea."},en:{entrar_contato_solucao:"or get in touch so we can find a solution for you."},es:{entrar_contato_solucao:"o cont\xe1ctanos para encontrar una soluci\xf3n para ti."}},{pt:{procedimentos:"Procedimentos"},en:{procedimentos:"Procedures"},es:{procedimentos:"Procedimientos"}},{pt:{entrar_contato_financeiro:"Entrar em \ncontato"},en:{entrar_contato_financeiro:"Get in \ntouch"},es:{entrar_contato_financeiro:"Ponerse en \ncontacto"}},{pt:{questionario_triagem:"Aplica\xe7\xe3o de Question\xe1rio de Triagem"},en:{questionario_triagem:"Screening Questionnaire Application"},es:{questionario_triagem:"Aplicaci\xf3n de Cuestionario de Evaluaci\xf3n"}},{pt:{pagar_fatura:"Pagar fatura"},en:{pagar_fatura:"Pay invoice"},es:{pagar_fatura:"Pagar factura"}},{pt:{questionario_auto_declaracao:"Aplicar question\xe1rio de Auto-Declara\xe7\xe3o do Empregado a cada avalia\xe7\xe3o para excluir riscos relacionados a sobrecarga;"},en:{questionario_auto_declaracao:"Apply Employee Self-Declaration questionnaire to each assessment to exclude risks related to overload;"},es:{questionario_auto_declaracao:"Aplicar el cuestionario de Autodeclaraci\xf3n del Empleado en cada evaluaci\xf3n para excluir los riesgos relacionados con la sobrecarga;"}},{pt:{cartao_restricao:"Cart\xe3o com alguma restri\xe7\xe3o (62)"},en:{cartao_restricao:"Card with some restriction (62)"},es:{cartao_restricao:"Tarjeta con alguna restricci\xf3n (62)"}},{pt:{protocolo_avaliacao:"Aplica\xe7\xe3o de Protocolo de Avalia\xe7\xe3o conforme estabelecido pelo projeto"},en:{protocolo_avaliacao:"Evaluation Protocol Application as established by the project"},es:{protocolo_avaliacao:"Aplicaci\xf3n del Protocolo de Evaluaci\xf3n seg\xfan lo establecido por el proyecto"}},{pt:{cartao_invalido_financeiro:"Cart\xe3o inv\xe1lido (14)"},en:{cartao_invalido_financeiro:"Invalid card (14)"},es:{cartao_invalido_financeiro:"Tarjeta inv\xe1lida (14)"}},{pt:{formulario_eva:"Aplica\xe7\xe3o de formul\xe1rio EVA (Escala Visual Avaliat\xf3ria) para avalia\xe7\xe3o e quantifica\xe7\xe3o de queixa de dor, em caso de queixas antes e/ou durante a realiza\xe7\xe3o dos testes/ protocolos."},en:{formulario_eva:"Application of the EVA (Visual Assessment Scale) form to assess and quantify pain complaints, in case of complaints before and/or during the tests/protocols."},es:{formulario_eva:"Aplicaci\xf3n del formulario EVA (Escala de Evaluaci\xf3n Visual) para evaluar y cuantificar las quejas de dolor, en caso de quejas antes y/o durante las pruebas/protocolos."}},{pt:{cartao_vencido:"Cart\xe3o vencido (54)"},en:{cartao_vencido:"Expired card (54)"},es:{cartao_vencido:"Tarjeta vencida (54)"}},{pt:{riscos_beneficios:"Riscos e Benef\xedcios"},en:{riscos_beneficios:"Risks and Benefits"},es:{riscos_beneficios:"Riesgos y Beneficios"}},{pt:{erro_sistema_adquirente:"Erro de sistema/adquirente (58)"},en:{erro_sistema_adquirente:"System/issuer error (58)"},es:{erro_sistema_adquirente:"Error de sistema/adquirente (58)"}},{pt:{riscos:"Riscos: Os procedimentos s\xe3o n\xe3o invasivos e n\xe3o apresentam riscos evidentes significativos."},en:{riscos:"Risks: The procedures are non-invasive and do not present any significant obvious risks."},es:{riscos:"Riesgos: Los procedimientos no son invasivos y no presentan riesgos obvios significativos."}},{pt:{falha_processar_transacao:"Falha ao processar a transa\xe7\xe3o (999)"},en:{falha_processar_transacao:"Transaction processing failure (999)"},es:{falha_processar_transacao:"Error al procesar la transacci\xf3n (999)"}},{pt:{beneficios:"Benef\xedcios: Avalia\xe7\xe3o osteomuscular direcionada e personalizada de grupos musculares espec\xedficos, considerando as caracter\xedsticas das atividades previstas. Al\xe9m de viabilizar a avalia\xe7\xe3o do processo evolutivo do contexto osteomuscular em acompanhamento."},en:{beneficios:"Benefits: Targeted and personalized musculoskeletal assessment of specific muscle groups, considering the characteristics of the planned activities. In addition to enabling the evaluation of the evolutionary process of the musculoskeletal context under monitoring."},es:{beneficios:"Beneficios: Evaluaci\xf3n musculoesquel\xe9tica dirigida y personalizada a grupos musculares espec\xedficos, teniendo en cuenta las caracter\xedsticas de las actividades planificadas. Adem\xe1s de permitir la evaluaci\xf3n del proceso evolutivo del contexto musculoesquel\xe9tico bajo seguimiento."}},{pt:{negado_banco_emissor:"Negado pelo banco emissor (05)"},en:{negado_banco_emissor:"Denied by the issuing bank (05)"},es:{negado_banco_emissor:"Negado por el banco emisor (05)"}},{pt:{participacao_voluntaria:"Participa\xe7\xe3o Volunt\xe1ria"},en:{participacao_voluntaria:"Voluntary Participation"},es:{participacao_voluntaria:"Participaci\xf3n Voluntaria"}},{pt:{saldo_insuficiente:"Saldo insuficiente (51)"},en:{saldo_insuficiente:"Insufficient funds (51)"},es:{saldo_insuficiente:"Saldo insuficiente (51)"}},{pt:{participacao_voluntaria_texto:"Sua participa\xe7\xe3o \xe9 volunt\xe1ria. Voc\xea pode desistir a qualquer momento sem preju\xedzo."},en:{participacao_voluntaria_texto:"Your participation is voluntary. You can withdraw at any time without prejudice."},es:{participacao_voluntaria_texto:"Su participaci\xf3n es voluntaria. Usted puede retirarse en cualquier momento sin perjuicio."}},{pt:{contato_banco:"Entre em contato com o seu banco ou tente novamente com o mesmo cart\xe3o ou outra forma de pagamento."},en:{contato_banco:"Contact your bank or try again with the same card or another payment method."},es:{contato_banco:"P\xf3ngase en contacto con su banco o intente nuevamente con la misma tarjeta o otro m\xe9todo de pago."}},{pt:{declaro_que_li:"Declaro que li e compreendi as informa\xe7\xf5es acima descritas relacionados a participa\xe7\xe3o das avalia\xe7\xf5es osteomusculares e:"},en:{declaro_que_li:"I declare that I have read and understood the information described above related to participation in musculoskeletal assessments and:"},es:{declaro_que_li:"Declaro que he le\xeddo y comprendido la informaci\xf3n descrita anteriormente relacionada con la participaci\xf3n en evaluaciones musculoesquel\xe9ticas y:"}},{pt:{inserir_cartao_valido:"Tente inserir novamente os dados de um cart\xe3o v\xe1lido."},en:{inserir_cartao_valido:"Try entering the details of a valid card again."},es:{inserir_cartao_valido:"Intente ingresar nuevamente los datos de una tarjeta v\xe1lida."}},{pt:{quero_participar:"Quero participar"},en:{quero_participar:"I want to participate"},es:{quero_participar:"Quiero participar"}},{pt:{verificar_pagamento:"Verifique a forma de pagamento e tente novamente."},en:{verificar_pagamento:"Check the payment method and try again."},es:{verificar_pagamento:"Verifique el m\xe9todo de pago e intente nuevamente."}},{pt:{nao_quero_participar:"N\xe3o quero participar"},en:{nao_quero_participar:"I do not want to participate"},es:{nao_quero_participar:"No quiero participar"}},{pt:{falha_pagamento:"Falha de Pagamento"},en:{falha_pagamento:"Payment Failure"},es:{falha_pagamento:"Fallo de Pago"}},{pt:{rever_termo_consentimento:"Rever termo de consentimento"},en:{rever_termo_consentimento:"Review consent form"},es:{rever_termo_consentimento:"Revisar formulario de consentimiento"}},{pt:{tentar_novamente_cartao:"Tentar novamente com cart\xe3o"},en:{tentar_novamente_cartao:"Try again with card"},es:{tentar_novamente_cartao:"Intentar nuevamente con tarjeta"}},{pt:{paciente_recusou:"Paciente recusou participa\xe7\xe3o"},en:{paciente_recusou:"Patient refused participation"},es:{paciente_recusou:"El paciente se neg\xf3 a participar"}},{pt:{pagar_por_pix:"Pagar por pix"},en:{pagar_por_pix:"Pay by pix"},es:{pagar_por_pix:"Pagar por pix"}},{pt:{nao_sera_possivel_realizar_avaliacoes:"N\xe3o ser\xe1 poss\xedvel realizar a avalia\xe7\xe3o sem a autoriza\xe7\xe3o do paciente. Sem a autoriza\xe7\xe3o, n\xe3o ser\xe1 poss\xedvel prosseguir com a coleta de dados desse paciente."},en:{nao_sera_possivel_realizar_avaliacoes:"It will not be possible to carry out the assessment without the patient's authorization. Without authorization, it will not be possible to proceed with the collection of data from that patient."},es:{nao_sera_possivel_realizar_avaliacoes:"No ser\xe1 posible realizar la valoraci\xf3n sin la autorizaci\xf3n del paciente. Sin autorizaci\xf3n, no ser\xe1 posible seguir recopilando datos de este paciente."}},{pt:{pagar_por_boleto:"Pagar por boleto"},en:{pagar_por_boleto:"Pay by boleto"},es:{pagar_por_boleto:"Pagar por boleto"}},{pt:{erro_encontrar_termo:"Erro ao encontrar o termo de consentimento do paciente, tente novamente."},en:{erro_encontrar_termo:"Error finding patient consent form, please try again."},es:{erro_encontrar_termo:"Error al encontrar el formulario de consentimiento del paciente, int\xe9ntelo nuevamente."}},{pt:{entrar_contato_financeiro2:"Entrar em contato"},en:{entrar_contato_financeiro2:"Get in touch"},es:{entrar_contato_financeiro2:"Ponerse en contacto"}},{pt:{posicao_gancho:"Posi\xe7\xe3o do dinam\xf4metro: Gancho"},en:{posicao_gancho:"Dynamometer position: Hook"},es:{posicao_gancho:"Posici\xf3n del dinam\xf3metro: Gancho"}},{pt:{pagamento_realizado:"Pagamento realizado"},en:{pagamento_realizado:"Payment completed"},es:{pagamento_realizado:"Pago realizado"}},{pt:{confirma_posicao_dino_paciente:"Voc\xea confirma que o dinam\xf4metro e o paciente est\xe3o na posi\xe7\xe3o correta para a avalia\xe7\xe3o da"},en:{confirma_posicao_dino_paciente:"You confirm that the dynamometer and patient are in the correct position for the assessment."},es:{confirma_posicao_dino_paciente:"Confirma que el dinam\xf3metro y el paciente est\xe1n en la posici\xf3n correcta para la evaluaci\xf3n."}},{pt:{debito_quitado:"Verificamos que o d\xe9bito foi quitado e seu acesso foi liberado."},en:{debito_quitado:"We have verified that the debt has been settled and your access has been granted."},es:{debito_quitado:"Hemos verificado que la deuda ha sido saldada y su acceso ha sido liberado."}},{pt:{confirmar_iniciar:"Confirmar e iniciar"},en:{confirmar_iniciar:"Confirm and start"},es:{confirmar_iniciar:"Confirmar y comenzar"}},{pt:{pagamento_parcial:"Voc\xea realizou o pagamento de uma fatura, mas ainda h\xe1 faturas pendentes."},en:{pagamento_parcial:"You have paid an invoice, but there are still pending invoices."},es:{pagamento_parcial:"Ha realizado el pago de una factura, pero a\xfan hay facturas pendientes."}},{pt:{disp_nao_conectado:"Dispositivo n\xe3o conectado \xe0 internet"},en:{disp_nao_conectado:"Device not connected to the internet"},es:{disp_nao_conectado:"Dispositivo no conectado a Internet"}},{pt:{pagamento_total:"Realize o pagamento delas para liberar o seu acesso."},en:{pagamento_total:"Make the payment to unlock your access."},es:{pagamento_total:"Realice el pago para liberar su acceso."}},{pt:{triagem:"Triagem"},en:{triagem:"Screening"},es:{triagem:"Evaluaci\xf3n"}},{pt:{entendi_financeiro:"Entendi"},en:{entendi_financeiro:"Got it"},es:{entendi_financeiro:"Entendido"}},{pt:{instrucao_avaliacao:"Antes de iniciar a avalia\xe7\xe3o, \xe9 importante coletar algumas informa\xe7\xf5es. Fa\xe7a as seguintes perguntas ao paciente. Ao final delas, avalie se o paciente est\xe1 apto para iniciar a avalia\xe7\xe3o de for\xe7a."},en:{instrucao_avaliacao:"Before starting the assessment, it is important to collect some information. Ask the patient the following questions. At the end, assess whether the patient is fit to begin the strength assessment."},es:{instrucao_avaliacao:"Antes de iniciar la evaluaci\xf3n, es importante recopilar algunas informaciones. Haga las siguientes preguntas al paciente. Al final, eval\xfae si el paciente est\xe1 apto para comenzar la evaluaci\xf3n de fuerza."}},{pt:{cartao_cadastrado:"Cart\xe3o cadastrado"},en:{cartao_cadastrado:"Registered card"},es:{cartao_cadastrado:"Tarjeta registrada"}},{pt:{decl_ausencia_atividade:"Declara\xe7\xe3o de aus\xeancia de atividade f\xedsica"},en:{decl_ausencia_atividade:"Declaration of absence of physical activity"},es:{decl_ausencia_atividade:"Declaraci\xf3n de ausencia de actividad f\xedsica"}},{pt:{clique_faturas_pendentes:"Clique nas faturas pendentes para fazer o pagamento delas."},en:{clique_faturas_pendentes:"Click on the pending invoices to make the payment."},es:{clique_faturas_pendentes:"Haga clic en las facturas pendientes para realizar el pago."}},{pt:{triagem_concluida:"Triagem conclu\xedda com sucesso"},en:{triagem_concluida:"Screening successfully completed"},es:{triagem_concluida:"Evaluaci\xf3n completada con \xe9xito"}},{pt:{pagamento_cartao_cadastrado:"Fa\xe7a o pagamento da fatura com o cart\xe3o cadastrado."},en:{pagamento_cartao_cadastrado:"Pay the invoice with the registered card."},es:{pagamento_cartao_cadastrado:"Pague la factura con la tarjeta registrada."}},{pt:{confirma_avaliacao:"Tem certeza que deseja avaliar o paciente hoje?"},en:{confirma_avaliacao:"Are you sure you want to assess the patient today?"},es:{confirma_avaliacao:"\xbfEst\xe1 seguro de que desea evaluar al paciente hoy?"}},{pt:{valor_fatura:"Valor da fatura"},en:{valor_fatura:"Invoice amount"},es:{valor_fatura:"Valor de la factura"}},{pt:{recomendacao_avaliacao:"Para fazer a avalia\xe7\xe3o, \xe9 recomendado que o paciente n\xe3o tenha realizado treino de muscula\xe7\xe3o nas regi\xf5es que ser\xe3o avaliadas nas \xfaltimas 48 horas. Ao realizar a avalia\xe7\xe3o sem respeitar esse intervalo, os resultados podem apresentar altera\xe7\xf5es."},en:{recomendacao_avaliacao:"To perform the assessment, it is recommended that the patient has not done strength training in the areas to be evaluated in the last 48 hours. Performing the assessment without respecting this interval may result in altered outcomes."},es:{recomendacao_avaliacao:"Para realizar la evaluaci\xf3n, se recomienda que el paciente no haya realizado entrenamiento de musculaci\xf3n en las regiones que ser\xe1n evaluadas en las \xfaltimas 48 horas. Si se realiza la evaluaci\xf3n sin respetar este intervalo, los resultados pueden presentar alteraciones."}},{pt:{pagar_cartao_cadastrado:"Pagar com cart\xe3o cadastrado"},en:{pagar_cartao_cadastrado:"Pay with registered card"},es:{pagar_cartao_cadastrado:"Pagar con tarjeta registrada"}},{pt:{recomendacao_reagendamento:"Recomendamos que encaminhe o paciente para realizar o reagendamento da avalia\xe7\xe3o. Como deseja prosseguir?"},en:{recomendacao_reagendamento:"We recommend that you refer the patient to reschedule the assessment. How would you like to proceed?"},es:{recomendacao_reagendamento:"Recomendamos que derive al paciente para reprogramar la evaluaci\xf3n. \xbfC\xf3mo desea proceder?"}},{pt:{copiar_codigo_baixar_boleto:"Baixe o boleto"},en:{copiar_codigo_baixar_boleto:"Download the bank slip"},es:{copiar_codigo_baixar_boleto:"Descargue el boleto"}},{pt:{interromper_avaliacao:"Interromper avalia\xe7\xe3o"},en:{interromper_avaliacao:"Stop assessment"},es:{interromper_avaliacao:"Interrumpir evaluaci\xf3n"}},{pt:{valor_boleto:"Valor do boleto"},en:{valor_boleto:"Boleto amount"},es:{valor_boleto:"Valor del boleto"}},{pt:{continuar_avaliacao:"Continuar avalia\xe7\xe3o"},en:{continuar_avaliacao:"Continue assessment"},es:{continuar_avaliacao:"Continuar evaluaci\xf3n"}},{pt:{codigo_boleto:"C\xf3digo do boleto"},en:{codigo_boleto:"Boleto code"},es:{codigo_boleto:"C\xf3digo del boleto"}},{pt:{escalada_dor:"Em uma escala de 10 a 0, como voc\xea classificaria o n\xedvel de dor?"},en:{escalada_dor:"On a scale from 10 to 0, how would you rate your pain level?"},es:{escalada_dor:"En una escala del 10 al 0, \xbfc\xf3mo clasificar\xeda su nivel de dolor?"}},{pt:{copiar_codigo_boleto:"Copiar c\xf3digo do boleto"},en:{copiar_codigo_boleto:"Copy boleto code"},es:{copiar_codigo_boleto:"Copiar c\xf3digo del boleto"}},{pt:{referencia_escala_dor:"Onde 0 corresponde a nenhuma dor e 10 corresponde a dor incapacitante"},en:{referencia_escala_dor:"Where 0 means no pain and 10 means debilitating pain"},es:{referencia_escala_dor:"Donde 0 corresponde a ninguna dolor y 10 corresponde a un dolor incapacitante"}},{pt:{baixar_boleto:"Baixar boleto"},en:{baixar_boleto:"Download boleto"},es:{baixar_boleto:"Descargar boleto"}},{pt:{nao_recomenda_avaliar:"N\xe3o recomendamos avaliar com esse n\xedvel de dor"},en:{nao_recomenda_avaliar:"We do not recommend assessing with this level of pain"},es:{nao_recomenda_avaliar:"No recomendamos evaluar con este nivel de dolor"}},{pt:{ja_fiz_pagamento:"J\xe1 fiz o pagamento"},en:{ja_fiz_pagamento:"I have already paid"},es:{ja_fiz_pagamento:"Ya hice el pago"}},{pt:{dor_acima_5:"O paciente apresenta uma dor com intensidade acima de 5. \xc9 poss\xedvel que essa dor interfira nos resultados da avalia\xe7\xe3o. Recomendamos que o paciente seja reagendado para outro dia."},en:{dor_acima_5:"The patient has a pain intensity above 5. This pain may interfere with the assessment results. We recommend rescheduling the patient for another day."},es:{dor_acima_5:"El paciente presenta un dolor con una intensidad superior a 5. Es posible que este dolor interfiera en los resultados de la evaluaci\xf3n. Recomendamos reprogramar al paciente para otro d\xeda."}},{pt:{pagamento_nao_identificado:"N\xe3o identificamos o seu pagamento"},en:{pagamento_nao_identificado:"We could not identify your payment"},es:{pagamento_nao_identificado:"No pudimos identificar su pago"}},{pt:{se_sim_especifique:"Se sim, especifique"},en:{se_sim_especifique:"If yes, specify"},es:{se_sim_especifique:"Si es as\xed, especifique"}},{pt:{melhor_momento_pagamento:"Quando \xe9 o melhor momento para fazer o pagamento?"},en:{melhor_momento_pagamento:"When is the best time to make the payment?"},es:{melhor_momento_pagamento:"\xbfCu\xe1ndo es el mejor momento para hacer el pago?"}},{pt:{efetue_exer_ordem:"Efetue os exerc\xedcios na ordem abaixo"},en:{efetue_exer_ordem:"Perform the exercises in the order below"},es:{efetue_exer_ordem:"Realice los ejercicios en el orden siguiente"}},{pt:{amanha:"Amanh\xe3"},en:{amanha:"Tomorrow"},es:{amanha:"Ma\xf1ana"}},{pt:{resultados_triagem:"Resultados Triagem"},en:{resultados_triagem:"Screening Results"},es:{resultados_triagem:"Resultados de la detecci\xf3n"}},{pt:{em_ate_7_dias:"Em at\xe9 7 dias"},en:{em_ate_7_dias:"Within 7 days"},es:{em_ate_7_dias:"En ha