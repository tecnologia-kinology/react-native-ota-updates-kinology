,en:{quiz_sf_36:'SF-36 Questionnaire'},es:{quiz_sf_36:'Cuestionario SF-36'}},{pt:{dor:'Dor'},en:{dor:'Pain'},es:{dor:'Dolor'}},{pt:{historico_questionario:'Hist\xf3rico de question\xe1rios'},en:{historico_questionario:'Questionnaire History'},es:{historico_questionario:'Historial de pruebas'}},{pt:{new_quiz:'Gerar um novo question\xe1rio'},en:{new_quiz:' Generate a new questionnaire'},es:{new_quiz:'Generar una nueva cuestionario'}},{pt:{continue_quiz:'Continuar question\xe1rio salvo'},en:{continue_quiz:'Continue Saved Questionnaire'},es:{continue_quiz:'Continuar cuestionario guardado'}},{pt:{historico_anamnese:'Hist\xf3rico de Anamneses'},en:{historico_anamnese:'History of Anamnesis'},es:{historico_anamnese:'Historia de la Anamnesis'}},{pt:{continue_anaminese:'Continuar Anamnese'},en:{continue_anaminese:'Continue Anamnesis'},es:{continue_anaminese:'Continuar Anamnesis'}},{pt:{relatorios_avaliacoes:'Relat\xf3rios das Avalia\xe7\xf5es'},en:{relatorios_avaliacoes:'Assessment Reports'},es:{relatorios_avaliacoes:'Informes de evaluaci\xf3n'}},{pt:{anamnese:'Anamnese'},en:{anamnese:'Anamnesis'},es:{anamnese:'Anamnesia'}},{pt:{atualizar_informacoes:'Atualizar informa\xe7\xf5es'},en:{atualizar_informacoes:'Update information'},es:{atualizar_informacoes:'Actualizar informaci\xf3n'}},{pt:{ultima_atualizacao:'\xdaltima atualiza\xe7\xe3o'},en:{ultima_atualizacao:'Last update'},es:{ultima_atualizacao:'\xdaltima actualizaci\xf3n'}},{pt:{exame_fisico_clinico:'Exame F\xedsico/Cl\xednico'},en:{exame_fisico_clinico:'Physical/Clinical Examination'},es:{exame_fisico_clinico:'Examen f\xedsico/cl\xednico'}},{pt:{alert_inadim_subTitle:'Atualize os dados de pagamento para voltar a utilizar as fun\xe7\xf5es exclusivas.'},en:{alert_inadim_subTitle:'Update payment details to use exclusive functions again.'},es:{alert_inadim_subTitle:'Actualice los detalles de pago para usar funciones exclusivas nuevamente.'}},{pt:{alert_inadim_title:'Ops... Houve um problema!'},en:{alert_inadim_title:'Oops... There was a problem!'},es:{alert_inadim_title:'Ups... \xa1Hubo un problema!'}},{pt:{valores_refes:'* Valor(es) de refer\xeancia de mediana de for\xe7a m\xe1xima em avalia\xe7\xe3o \t\t\t\t\t\t\tisom\xe9trica para paciente do sexo masculino dentro da faixa et\xe1ria \t\t\t\t\t\t\tde 20 a 24 anos (MELDRUM, 2007) e para paciente do sexo masculino \t\t\t\t\t\t\te feminino dentro da faixa et\xe1ria de 20 a 39 anos (PASCO, 2020).'},en:{valores_refes:' * Maximum strength median reference value(s) under evaluation isometric for male patient within age group from 20 to 24 years old (MELDRUM, 2007) and for a male patient and female within the age group of 20 to 39 years (PASCO, 2020).'},es:{valores_refes:'* Valor(es) de referencia de la mediana de la resistencia m\xe1xima en evaluaci\xf3n isom\xe9trico para paciente masculino dentro del grupo de edad de 20 a 24 a\xf1os (MELDRUM, 2007) y para un paciente masculino y femenino dentro del grupo de edad de 20 a 39 a\xf1os (PASCO, 2020).'}},{pt:{dino_foi_desconectado:'O dinam\xf4metro foi desconectado'},en:{dino_foi_desconectado:'The dynamometer has been disconnected'},es:{dino_foi_desconectado:'El dinam\xf3metro ha sido desconectado.'}},{pt:{dino_desconectado:'Dinam\xf4 desconectado'},en:{dino_desconectado:'Dynamo disconnected'},es:{dino_desconectado:'D\xednamo desconectado'}},{pt:{dinamo_esta_conectado:'Dinam\xf4metro est\xe1 conectado ao seu dispositivo'},en:{dinamo_esta_conectado:'Dynamometer is connected to your device'},es:{dinamo_esta_conectado:'El dinam\xf3metro est\xe1 conectado a su dispositivo'}},{pt:{dinamo_conectado:'Dinam\xf4 conectado'},en:{dinamo_conectado:'Connected dynamo'},es:{dinamo_conectado:'dinamo conectado'}},{pt:{yes:'Sim'},en:{yes:'Yes'},es:{yes:'S\xed'}},{pt:{not:'N\xe3o'},en:{not:'No'},es:{not:'No'}},{pt:{email_deve_corresponder:'Os e-mails devem corresponder'},en:{email_deve_corresponder:'Emails must match'},es:{email_deve_corresponder:'Los e-mails deben coincidir'}},{pt:{nenhum_exercicio_selecionado:'Nenhum exerc\xedcio para selecionar'},en:{nenhum_exercicio_selecionado:'No exercises to select'},es:{nenhum_exercicio_selecionado:'No hay ejercicios para seleccionar'}},{pt:{modal_upgrade_descricao:'Mas calma, para resolver isto \xe9 simples. Basta entrar em contato com a gente e solicitar a mudan\xe7a no seu pacote de servi\xe7os.'},en:{modal_upgrade_descricao:'But calm down, to solve this is simple. Just contact us and request a change in your service package.'},es:{modal_upgrade_descricao:'Pero tranquilos, solucionar esto es sencillo. Solo cont\xe1ctenos y solicite un cambio en su paquete de servicios.'}},{pt:{modal_upgrade_funcionalidade:'Voc\xea ainda n\xe3o tem acesso a essa funcionalidade'},en:{modal_upgrade_funcionalidade:'You do not yet have access to this functionality'},es:{modal_upgrade_funcionalidade:'Todav\xeda no tienes acceso a esta funcionalidad'}},{pt:{descricao_permissao_armazenamento:'Utilizamos essa permiss\xe3o para armazenar os dados dos exerc\xedcios'},en:{descricao_permissao_armazenamento:'We use this permission to store exercise data'},es:{descricao_permissao_armazenamento:'Usamos este permiso para almacenar datos de ejercicio.'}},{pt:{permissao_entrar_contato:'Permiss\xe3o para entrar em contato via telefone e/ou e-mail, se necess\xe1rio.'},en:{permissao_entrar_contato:'Permission to contact you via phone and/or email if necessary.'},es:{permissao_entrar_contato:'Permiso para contactarlo por tel\xe9fono y/o correo electr\xf3nico si es necesario.'}},{pt:{descricao_permissao_notificacoes:'Fique por dentro de todas as novidades e atualiza\xe7\xf5es da Kinology'},en:{descricao_permissao_notificacoes:'Stay up to date with all the news and updates from Kinology'},es:{descricao_permissao_notificacoes:'Mant\xe9ngase al d\xeda con todas las noticias y actualizaciones de Kinology'}},{pt:{descricao_permissao_camera:'Utilize a c\xe2mera para personalizar os perfis dos pacientes e fisioterapeutas'},en:{descricao_permissao_camera:'Use the camera to customize the profiles of patients and physical therapists'},es:{descricao_permissao_camera:'Utilice una c\xe1mara para personalizar o perfis dos pacientes e fisioterapeutas'}},{pt:{descricao_permissao_ble:'Sincronizamos o smartphone com o dinam\xf4 atrav\xe9s do bluetooth'},en:{descricao_permissao_ble:'We synchronize the smartphone with the dinam\xf4 through bluetooth'},es:{descricao_permissao_ble:'Sincronizamos el smartphone con la dinamo a trav\xe9s de bluetooth'}},{pt:{descricao_permissao_localizacao:'Utilizamos a geolocaliza\xe7\xe3o para sincronizar com o dinam\xf4'},en:{descricao_permissao_localizacao:'We use geolocation to sync with dynamo'},es:{descricao_permissao_localizacao:'Usamos geolocalizaci\xf3n para sincronizar con dinamo'}},{pt:{armazenamento:'Armazenamento'},en:{armazenamento:'Storage'},es:{armazenamento:'Almacenamiento'}},{pt:{notificacoes:'Notifica\xe7\xf5es'},en:{notificacoes:'Notifications'},es:{notificacoes:'Notificaciones'}},{pt:{a:'a'},en:{a:'to'},es:{a:'a'}},{pt:{habilitar_permissoes:'\xc9 necess\xe1rio conceder as permiss\xf5es de acesso para prosseguir.'},en:{habilitar_permissoes:'You must grant access permissions to proceed.'},es:{habilitar_permissoes:'Debe otorgar permisos de acceso para continuar.'}},{pt:{habilitar:'Conceder permiss\xf5es'},en:{habilitar:'Grant permissions'},es:{habilitar:'Otorgar permisos'}},{pt:{aviso_exercicio_funcional:'Exerc\xedcios realizados em modo funcional n\xe3o s\xe3o contabilizados no relat\xf3rio de assimetria'},en:{aviso_exercicio_funcional:'Exercises performed in functional mode are not counted in the asymmetry report'},es:{aviso_exercicio_funcional:'Los ejercicios realizados en modo funcional no se contabilizan en el informe de asimetr\xeda'}},{pt:{basta_pedir_adm:'Mas calma, pra resolver isto \xe9 simples. Basta falarAdministrador da sua conta para realizar um Upgrade.'},en:{basta_pedir_adm:'But calm down, to solve this is simple. just talk to the Administrator of your account to perform an Upgrade.'},es:{basta_pedir_adm:'Pero tranquilos, solucionar esto es sencillo. solo habla con el Administrador de su cuenta para realizar un Upgrade.'}},{pt:{antes_continuar_verifique_ble:'Antes de continuar, verifique se seu bluetooth est\xe1 ativado'},en:{antes_continuar_verifique_ble:'Before proceeding, make sure your bluetooth is turned on'},es:{antes_continuar_verifique_ble:'Antes de continuar, aseg\xfarese de que su bluetooth est\xe9 encendido'}},{pt:{basta_realizar_upgrade:'Mas calma, pra resolver isto \xe9 simples. Basta realizar um UPGRADE no seu plano.'},en:{basta_realizar_upgrade:'But calm down, to solve this is simple. Just perform an UPGRADE on your plan.'},es:{basta_realizar_upgrade:'Pero tranquilos, solucionar esto es sencillo. Simplemente realice una ACTUALIZACI\xd3N en su plan.'}},{pt:{error_assinatura:'Erro ao tentar realizar assinatura!'},en:{error_assinatura:'Error trying to subscribe!'},es:{error_assinatura:'\xa1Error al intentar suscribirse!'}},{pt:{assinatura_realizada:'Assinatura realizada com sucesso!'},en:{assinatura_realizada:'Subscription successfully completed!'},es:{assinatura_realizada:'\xa1Suscripci\xf3n completada con \xe9xito!'}},{pt:{falha_faturas:'Falha de faturas pendentes.'},en:{falha_faturas:'Failed outstanding invoices.'},es:{falha_faturas:'Facturas pendientes fallidas.'}},{pt:{erro_iugu:'Falha ao buscar c\xf3digo Iugu'},en:{erro_iugu:'Failed to fetch Iugu code'},es:{erro_iugu:'Error al obtener el c\xf3digo Iugu'}},{pt:{buscar:'Buscar'},en:{buscar:'Search'},es:{buscar:'Buscar'}},{pt:{fita_elastic:'Fita para avalia\xe7\xe3o Kinology'},en:{fita_elastic:'Kinology Assessment Tape'},es:{fita_elastic:'Cinta de evaluaci\xf3n Kinology'}},{pt:{tornozeleira:'Tornozeleira profissional  Kinology'},en:{tornozeleira:'Kinology professional ankle bracelet'},es:{tornozeleira:'Tobillera profesional Kinology'}},{pt:{fixador_espaldar:'Fixador de espaldar para treinamento'},en:{fixador_espaldar:'Back support for training'},es:{fixador_espaldar:'Soporte de espalda para entrenamiento.'}},{pt:{fixador_espaldar_description:'Aumente as possibilidades do seu treinamento com o Fixador de Espaldar para Treinamento Funcional da Kinology.'},en:{fixador_espaldar_description:'Back support for training'},es:{fixador_espaldar_description:'Soporte de espalda para entrenamiento.'}},{pt:{bolsa_organizadora:'Bolsa organizadora academia'},en:{bolsa_organizadora:'Gym organizer bag'},es:{bolsa_organizadora:'Bolsa organizadora de gimnasio'}},{pt:{bolsa_organizadora_description:'A Bolsa Organizadora Dur\xe1vel para Academia da Iniciativa Fitness \xe9 o produto de alta qualidade que voc\xea precisa para ter mais praticidade no transporte.'},en:{bolsa_organizadora_description:'The Fitness Initiative Durable Gym Organizer Bag is the high-quality product you need for more practical transport.'},es:{bolsa_organizadora_description:'La bolsa organizadora de gimnasio duradera Fitness Initiative es el producto de alta calidad que necesita para un transporte m\xe1s pr\xe1ctico.'}},{pt:{tornozeleira_descripition:'A Tornozeleira Profissional Kinology \xe9 a escolha certa para facilitar seu treinamento com conforto e praticidade.'},en:{tornozeleira_descripition:'The Kinology Professional Ankle Brace is the right choice to facilitate your training with comfort and practicality.'},es:{tornozeleira_descripition:'La Tobillera Profesional Kinology es la elecci\xf3n adecuada para facilitar tu entrenamiento con comodidad y practicidad.'}},{pt:{indisponivel:'Item indispon\xedvel'},en:{indisponivel:'Item unavailable'},es:{indisponivel:'Art\xedculo no disponible'}},{pt:{movimento:'Movimento'},en:{movimento:'Movement'},es:{movimento:'Movimiento'}},{pt:{local:'Local'},en:{local:'Location'},es:{local:'Ubicaci\xf3n'}},{pt:{relacoes_preferenciais:'Rela\xe7\xf5es referenciais'},en:{relacoes_preferenciais:'Referential relations'},es:{relacoes_preferenciais:'Relaciones referenciales'}},{pt:{razao:'Raz\xe3o'},en:{razao:'Reason'},es:{razao:'Raz\xf3n'}},{pt:{resultados_contabilizados_desequilibrio:'Resultados contabilizados a partir das \xfaltimas execu\xe7\xf5es dos lados direito e esquerdo realizadas no mesmo dia. Para garantir a confiabilidade, execu\xe7\xf5es feitas em dias diferentes n\xe3o ser\xe3o consideradas. Caso haja mais de uma execu\xe7\xe3o no mesmo dia, ser\xe1 utilizada a \xfaltima. Utilizamos uma margem de 10% para mais ou para menos em rela\xe7\xe3o \xe0 raz\xe3o esperada. Valores fora dessa margem indicam desvio.'},en:{resultados_contabilizados_desequilibrio:'Results calculated from the last executions of the right and left sides performed on the same day. To ensure reliability, executions performed on different days will not be considered. If there is more than one execution on the same day, the last one will be used. We use a margin of 10% more or less in relation to the expected ratio. Values \u200b\u200boutside this margin indicate deviation.'},es:{resultados_contabilizados_desequilibrio:'Resultados calculados a partir de las \xfaltimas ejecuciones de los bandos derecho e izquierdo realizadas el mismo d\xeda. Para garantizar la confiabilidad, no se considerar\xe1n corridas realizadas en d\xedas diferentes. Si hay m\xe1s de una ejecuci\xf3n el mismo d\xeda, se utilizar\xe1 la \xfaltima. Utilizamos un margen del 10% m\xe1s o menos en relaci\xf3n al ratio esperado. Los valores fuera de este rango indican una desviaci\xf3n.'}},{pt:{chance_lesao_desequilibrio:'H\xe1 chance de les\xe3o'},en:{chance_lesao_desequilibrio:'There is a chance of injury'},es:{chance_lesao_desequilibrio:'Existe la posibilidad de lesionarse'}},{pt:{baixa_chance_lesao_desequilibrio:'Baixa chance de les\xe3o'},en:{baixa_chance_lesao_desequilibrio:'Low chance of injury'},es:{baixa_chance_lesao_desequilibrio:'Baja probabilidad de lesi\xf3n'}},{pt:{chance_lesao_movimento:'Chance de les\xe3o por assimetria de movimento:'},en:{chance_lesao_movimento:'Chance of injury due to movement asymmetry:'},es:{chance_lesao_movimento:'Posibilidad de lesi\xf3n por asimetr\xeda de movimiento:'}},{pt:{dados_desequilibrio_insulficiente:'Dados insuficientes. Realize a avalia\xe7\xe3o de for\xe7a do paciente.'},en:{dados_desequilibrio_insulficiente:'Insufficient data. Perform a strength assessment of the patient.'},es:{dados_desequilibrio_insulficiente:'Datos insuficientes. Realizar la evaluaci\xf3n de la fuerza del paciente.'}},{pt:{desvio:'Desvio'},en:{desvio:'Detour'},es:{desvio:'Desv\xedo'}},{pt:{razao_referencial:'Raz\xe3o \nreferencial'},en:{razao_referencial:'Referential \nreason'},es:{razao_referencial:'Ratio \nreferencial'}},{pt:{alca_mao:'Al\xe7a de m\xe3o para exerc\xedcios de puxada'},en:{alca_mao:'Hand strap for pulling exercises'},es:{alca_mao:'Correa de mano para ejercicios de tracci\xf3n.'}},{pt:{alca_mao_description:'A Al\xe7a de M\xe3o Kinology para Exerc\xedcios de Puxada da Iniciativa Fitness \xe9 essencial para melhorar seus treinos.'},en:{alca_mao_description:'The Fitness Initiative Kinology Hand Strap for Pulling Exercises is essential for improving your workouts.'},es:{alca_mao_description:'La correa de mano Kinology para ejercicios de tracci\xf3n Fitness Initiative es esencial para mejorar tus entrenamientos.'}},{pt:{full_tornozeleira_description:'A Tornozeleira Profissional Kinology \xe9 a escolha certa para facilitar seu treinamento com conforto e praticidade. Desfrute de maior conforto e seguran\xe7a durante os exerc\xedcios com essa tornozeleira de alta qualidade. Confeccionada em Gorgur\xe3o polipropileno resistente e revestida com EVA macio, ela possui um fecho de velcro com fecho duplo interno e externo, garantindo um ajuste perfeito. Al\xe9m disso, apresenta uma meia argola em metal resistente para maior durabilidade.'},en:{full_tornozeleira_description:'The Kinology Professional Ankle Brace is the right choice to facilitate your training with comfort and practicality. Enjoy greater comfort and safety during exercise with this high-quality ankle bracelet. Made from resistant polypropylene grosgrain and coated with soft EVA, it has a velcro closure with double internal and external closure, ensuring a perfect fit. In addition, it features a resistant metal half ring for greater durability.'},es:{full_tornozeleira_description:'La Tobillera Profesional Kinology es la elecci\xf3n adecuada para facilitar tu entrenamiento con comodidad y practicidad. Disfruta de una mayor comodidad y seguridad durante el ejercicio con esta tobillera de alta calidad. Confeccionado en resistente grosgrain de polipropileno y recubierto de suave EVA, tiene un cierre de velcro con doble cierre interno y externo, asegurando un ajuste perfecto. Adem\xe1s, cuenta con una media anilla de metal resistente para mayor durabilidad.'}},{pt:{full_fixador_espaldar_description:'Aumente as possibilidades do seu treinamento com o Fixador de Espaldar para Treinamento Funcional da Iniciativa Fitness. Transforme seu espaldar em uma esta\xe7\xe3o completa de exerc\xedcios, permitindo realizar uma variedade de movimentos para fortalecer e tonificar seu corpo. Confeccionado com materiais de alta qualidade, como Gorgur\xe3o polipropileno, EVA, Velcro e meia argola em metal, o Fixador de Espaldar garante durabilidade e seguran\xe7a durante os treinos.'},en:{full_fixador_espaldar_description:'Increase the possibilities of your training with the Backrest Fixator for Functional Training from Initiative Fitness. Turn your back into a complete exercise station, allowing you to perform a variety of movements to strengthen and tone your body. Made with high quality materials, such as polypropylene Grosgrain, EVA, Velcro and a metal half ring, the Backrest Fixator guarantees durability and safety during training.'},es:{full_fixador_espaldar_description:'Aumenta las posibilidades de tu entrenamiento con el Fijador de Respaldo para Entrenamiento Funcional de Initiative Fitness. Convierte tu espalda en una completa estaci\xf3n de ejercicios, permiti\xe9ndote realizar una variedad de movimientos para fortalecer y tonificar tu cuerpo. Fabricado con materiales de alta calidad, como polipropileno Grosgrain, EVA, velcro y media anilla de metal, el Fijador de Respaldo garantiza durabilidad y seguridad durante el entrenamiento.'}},{pt:{full_bolsa_organizadora_description:'A Bolsa Organizadora Dur\xe1vel para Academia da Iniciativa Fitness \xe9 o produto de alta qualidade que voc\xea precisa para ter mais praticidade no transporte e organiza\xe7\xe3o do seu kit de treino. Fabricada em Nylon Atlanta com costura refor\xe7ada, essa bolsa \xe9 sin\xf4nimo de durabilidade e resist\xeancia. Com medidas de 015 x 020 x 010, ela oferece espa\xe7o suficiente para acomodar seus equipamentos de forma organizada'},en:{full_bolsa_organizadora_description:'The Fitness Initiative Durable Gym Organizer Bag is the high-quality product you need to be more practical in transporting and organizing your training kit. Made from Nylon Atlanta with reinforced stitching, this bag is synonymous with durability and resistance. With measurements of 015 x 020 x 010, it offers enough space to accommodate your equipment in an organized way'},es:{full_bolsa_organizadora_description:'La bolsa organizadora de gimnasio duradera Fitness Initiative es el producto de alta calidad que necesitas para ser m\xe1s pr\xe1ctico a la hora de transportar y organizar tu kit de entrenamiento. Fabricada en Nylon Atlanta con costuras reforzadas, esta bolsa es sin\xf3nimo de durabilidad y resistencia. Con unas medidas de 015 x 020 x 010, ofrece espacio suficiente para acomodar tu equipo de forma organizada'}},{pt:{full_alca_mao_description:'A Al\xe7a de M\xe3o Kinology para Exerc\xedcios de Puxada da Iniciativa Fitness \xe9 essencial para melhorar seus treinos. Projetada para oferecer conforto e seguran\xe7a, essa al\xe7a proporciona uma pegada firme durante a execu\xe7\xe3o dos exerc\xedcios. Os exerc\xedcios de puxada s\xe3o ideais para fortalecer os m\xfasculos dos ombros, costas, peito, b\xedceps e tr\xedceps, al\xe9m de contribuir para o condicionamento f\xedsico.'},en:{full_alca_mao_description:'The Fitness Initiative Kinology Hand Strap for Pulling Exercises is essential for improving your workouts. Designed to offer comfort and safety, this strap provides a firm grip while performing exercises. Pulling exercises are ideal for strengthening the muscles of the shoulders, back, chest, biceps and triceps, as well as contributing to physical conditioning.'},es:{full_alca_mao_description:'La correa de mano Kinology para ejercicios de tracci\xf3n Fitness Initiative es esencial para mejorar tus entrenamientos. Dise\xf1ada para ofrecer comodidad y seguridad, esta correa proporciona un agarre firme mientras se realizan ejercicios. Los ejercicios de tracci\xf3n son ideales para fortalecer los m\xfasculos de los hombros, espalda, pecho, b\xedceps y tr\xedceps, adem\xe1s de contribuir al acondicionamiento f\xedsico.'}},{pt:{comprar_em_site_parceiro:'Comprar em site parceiro'},en:{comprar_em_site_parceiro:'Buy on partner website'},es:{comprar_em_site_parceiro:'Comprar en el sitio web asociado'}},{pt:{falar_com_consultor:'Falar com Consultor'},en:{falar_com_consultor:'Speak to Consultant'},es:{falar_com_consultor:'Habla con el consultor'}},{pt:{concordo_com_disposicoes:'e que concordo com todas as suas disposi\xe7\xf5es.*'},en:{concordo_com_disposicoes:'and that I agree to all of its provisions.*'},es:{concordo_com_disposicoes:'y que estoy de acuerdo con todas sus disposiciones.*'}},{pt:{contrato_service:'CONTRATO DE SERVI\xc7O DA Kinology'},en:{contrato_service:'Kinology SERVICE AGREEMENT'},es:{contrato_service:'ACUERDO DE SERVICIO Kinology'}},{pt:{declaro_q_li:'Declaro que li o'},en:{declaro_q_li:'I declare that I have read the'},es:{declaro_q_li:'Declaro que he le\xeddo el'}},{pt:{loja_parceira:'Loja'},en:{loja_parceira:'Store'},es:{loja_parceira:'Tienda'}},{pt:{ativar_ble:'Ative seu bluetooth para continuar'},en:{ativar_ble:'Activate your bluetooth to continue'},es:{ativar_ble:'Activa tu bluetooth para continuar'}},{pt:{antes_continuar_verifique_ble_permissao:'Antes de continuar, verifique se o Kinology tem permiss\xe3o para utilizar o bluetooth'},en:{antes_continuar_verifique_ble_permissao:'Before proceeding, make sure that Kinology is allowed to use bluetooth'},es:{antes_continuar_verifique_ble_permissao:'Antes de continuar, aseg\xfarese de que Kinology pueda usar bluetooth'}},{pt:{antes_continuar_verifique_bluetooth:'Antes de continuar, verifique se seu bluetooth e GPS est\xe3o ativados'},en:{antes_continuar_verifique_bluetooth:'Before proceeding, make sure your bluetooth and GPS are turned on'},es:{antes_continuar_verifique_bluetooth:'Antes de continuar, aseg\xfarese de que su bluetooth y GPS est\xe9n encendidos'}},{pt:{de_permissao_ble:'D\xea permiss\xe3o sobre o bluetooth ao Kinology para continuar'},en:{de_permissao_ble:'Give Kinology bluetooth permission to continue'},es:{de_permissao_ble:'Dar permiso a Kinology bluetooth para continuar'}},{pt:{conectado_sucesso_ble:'Conectado com sucesso!'},en:{conectado_sucesso_ble:'Successfully connected!'},es:{conectado_sucesso_ble:'\xa1Conectado con \xe9xito!'}},{pt:{ativar_gps:'Ative seu GPS para continuar'},en:{ativar_gps:'Activate your GPS to continue'},es:{ativar_gps:'Activa tu GPS para continuar'}},{pt:{antes_continuar_verifique_gps:'Antes de continuar, verifique se seu GPS est\xe1 ativado'},en:{antes_continuar_verifique_gps:'Before proceeding, make sure your GPS is turned on'},es:{antes_continuar_verifique_gps:'Antes de continuar, aseg\xfarese de que su GPS est\xe9 encendido'}},{pt:{ativar_ble_gps:'Ative seu Bluetooth e GPS para continuar'},en:{ativar_ble_gps:'Activate your Bluetooth and GPS to continue'},es:{ativar_ble_gps:'Activa tu Bluetooth y GPS para continuar'}},{pt:{ativar_ble_gps_permissao_gps:'Ative seu Bluetooth, GPS e conceda permiss\xe3o a GPS para continuar'},en:{ativar_ble_gps_permissao_gps:'Activate your Bluetooth, GPS and grant GPS permission to continue'},es:{ativar_ble_gps_permissao_gps:'Active su