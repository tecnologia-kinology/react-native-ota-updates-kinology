a_erro_invalida:'Contrase\xf1a invalida'}},{pt:{login_input_senha:'Campo obrigat\xf3rio'},en:{login_input_senha:'Required field'},es:{login_input_senha:'Campo obligatorio'}},{pt:{login_senha:'Senha*'},en:{login_senha:'Password*'},es:{login_senha:'Contrase\xf1a*'}},{pt:{login_input_email:'E-mail inv\xe1lido ou n\xe3o preenchido'},en:{login_input_email:'Invalid or unfilled email'},es:{login_input_email:'Correo electr\xf3nico no v\xe1lido o sin completar'}},{pt:{idioma_linguagem:'Selecione um idioma'},en:{idioma_linguagem:'Select a language'},es:{idioma_linguagem:'Selecciona un idioma'}},{pt:{pag_inicial_menu_inferior_protocolo:'Protocolo'},en:{pag_inicial_menu_inferior_protocolo:'Protocol'},es:{pag_inicial_menu_inferior_protocolo:'Protocolo'}},{pt:{hipertrofia:'Hipertrofia'},en:{hipertrofia:'Hypertrophy'},es:{hipertrofia:'Hipertrofia'}},{pt:{resistencia:'Resist\xeancia'},en:{resistencia:'Resistance'},es:{resistencia:'Resistencia'}},{pt:{serie_option1:'3 a 5 s\xe9ries com 1 a 6 repeti\xe7\xf5es - executado explosivo com recupera\xe7\xe3o de 180 a 300 segundos'},en:{serie_option1:'3 to 5 sets of 1 to 6 reps - performed explosively with 180 to 300 seconds of recovery'},es:{serie_option1:'3 a 5 series con 1 a 6 repeticiones - realizadas de manera explosiva con 180 a 300 segundos de recuperaci\xf3n'}},{pt:{serie_option2:'3 a 5 s\xe9ries com 7 a 12 repeti\xe7\xf5es - executado lento com recupera\xe7\xe3o de 90 a 180 segundos'},en:{serie_option2:'3 to 5 sets of 7 to 12 reps - performed slowly with 90 to 180 seconds recovery'},es:{serie_option2:'3 a 5 series de 7 a 12 repeticiones - realizadas lentamente con recuperaci\xf3n de 90 a 180 segundos'}},{pt:{serie_option3:'3 a 6 s\xe9ries com no m\xednimo 13 repeti\xe7\xf5es - executado r\xe1pido com recupera\xe7\xe3o de 30 a 90 segundos'},en:{serie_option3:'3 to 6 sets of at least 13 repetitions - performed quickly with 30 to 90 seconds recovery'},es:{serie_option3:'De 3 a 6 series con al menos 13 repeticiones, realizadas r\xe1pidamente con una recuperaci\xf3n de 30 a 90 segundos.'}},{pt:{rmi_info:'*RMi \xe9 o valor de Repeti\xe7\xe3o M\xe1xima Isom\xe9trica. Os resultados do teste de 1RM isom\xe9trico podem n\xe3o corresponder diretamente aos resultados do teste de 1RM din\xe2mico, pois envolvem diferentes tipos de contra\xe7\xe3o muscular. A Taxa de Desenvolvimento de For\xe7a (TDF) representa a for\xe7a muscular explosiva ou a habilidade de aumentar a for\xe7a ou torque o mais r\xe1pido poss\xedvel durante uma contra\xe7\xe3o muscular r\xe1pida em um pequeno intervalo de tempo.'},en:{rmi_info:'*RMi is the Isometric Repetition Maximum value. The results of the isometric 1RM test may not directly correspond to the results of the dynamic 1RM test because they involve different types of muscle contraction. Rate of Force Development (RFD) represents explosive muscular strength, or the ability to increase force or torque as quickly as possible during a rapid muscle contraction in a short period of time.'},es:{rmi_info:'*RMi es el valor de repetici\xf3n isom\xe9trica m\xe1xima. Es posible que los resultados de la prueba isom\xe9trica de 1RM no se correspondan directamente con los resultados de la prueba din\xe1mica de 1RM, ya que implican diferentes tipos de contracci\xf3n muscular. La tasa de desarrollo de fuerza (TDF) representa la fuerza muscular explosiva o la capacidad de aumentar la fuerza o el torque lo m\xe1s r\xe1pido posible durante una contracci\xf3n muscular r\xe1pida en un corto intervalo de tiempo.'}},{pt:{pag_inicial_menu_inferior_home:'In\xedcio '},en:{pag_inicial_menu_inferior_home:'Home'},es:{pag_inicial_menu_inferior_home:'Comienzo'}},{pt:{taxa_desenvolvimento_forca:'Taxa de Desenvolvimento de for\xe7a'},en:{taxa_desenvolvimento_forca:'Rate of Force Development'},es:{taxa_desenvolvimento_forca:'Tasa de desarrollo de fuerza'}},{pt:{forca_muscular_explosiva:'Representa a for\xe7a muscular explosiva ou a habilidade de aumentar a for\xe7a ou torque o mais r\xe1pido poss\xedvel durante uma contra\xe7\xe3o muscular r\xe1pida em um pequeno intervalo de tempo.'},en:{forca_muscular_explosiva:'It represents explosive muscle strength or the ability to increase force or torque as quickly as possible during a rapid muscle contraction in a short period of time.'},es:{forca_muscular_explosiva:'Representa la fuerza muscular explosiva o la capacidad de aumentar la fuerza o el torque lo m\xe1s r\xe1pido posible durante una contracci\xf3n muscular r\xe1pida en una peque\xf1a cantidad de tiempo.'}},{pt:{pag_inicial_avaliador:'Avaliador'},en:{pag_inicial_avaliador:'Evaluator'},es:{pag_inicial_avaliador:'Evaluador'}},{pt:{repeticoes_maximas:'Repeti\xe7\xf5es M\xe1ximas'},en:{repeticoes_maximas:'Maximum Repetitions'},es:{repeticoes_maximas:'Repeticiones m\xe1ximas'}},{pt:{data_da_avaliacao:'Data da avalia\xe7\xe3o'},en:{data_da_avaliacao:'Date of assessment'},es:{data_da_avaliacao:'Fecha de evaluaci\xf3n'}},{pt:{utilizando_forca_maxima:'Utilizando a For\xe7a M\xe1xima Isom\xe9trica, calculamos a carga correspondente para 1 Repeti\xe7\xe3o M\xe1xima (1RM). Utilize as cargas para a prescri\xe7\xe3o e periodiza\xe7\xe3o de exerc\xedcios. '},en:{utilizando_forca_maxima:'Using Maximum Isometric Strength, we calculate the corresponding load for 1 Repetition Maximum (1RM). Use the loads for exercise prescription and periodization. '},es:{utilizando_forca_maxima:'Utilizando la Fuerza M\xe1xima Isom\xe9trica, calculamos la carga correspondiente para 1 Repetici\xf3n M\xe1xima (1RM). Utilice cargas para la prescripci\xf3n y periodizaci\xf3n del ejercicio. '}},{pt:{menu_lateral_config_permissoes:'Permiss\xf5es'},en:{menu_lateral_config_permissoes:'Permissions'},es:{menu_lateral_config_permissoes:'Permisos'}},{pt:{menu_lateral_geral:'Gerais'},en:{menu_lateral_geral:'General'},es:{menu_lateral_geral:'General'}},{pt:{pag_inicial_menu_inferior_mais:'Mais'},en:{pag_inicial_menu_inferior_mais:'More'},es:{pag_inicial_menu_inferior_mais:'M\xe1s'}},{pt:{login_email:'E-mail*'},en:{